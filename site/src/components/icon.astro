---
import type { JSX } from "astro/jsx-runtime";

export type IconSets = "lucide" | "svg-spinners" | "line-md";
export type IconName = `${IconSets}--${string}`;

interface Props extends JSX.HTMLAttributes {
	name: IconName;
}

const { name, class: className, ...props } = Astro.props;
---

<span class:list={["iconify", name, className]} {...props}></span>
