---
export type IconSets = "lucide" | "svg-spinners" | "line-md";
export type IconName = `${IconSets}--${string}`;

interface Props {
	name: IconName;
	class?: string;
	style?: string;
}

const { name, class: className, style } = Astro.props;
---

<span class:list={["iconify", name, className]} {style}></span>

<style is:global>
	@reference "../styles/global.css";

	@plugin "@iconify/tailwind4" {
		prefixes: lucide, svg-spinners, line-md;
	}

	@utility iconify {
		@apply size-4;
	}
</style>
