---
import {
	type PlayerBandMember,
	type PlayerBandMemberStateless,
} from "@bandori-stats/database/tracker";
import { getProfileIcon } from "~/lib/assets";

interface Props {
	member: PlayerBandMemberStateless & Partial<PlayerBandMember>;
	class?: string;
}

const { member, class: className } = Astro.props;
---

<div class:list={["gbp-card", className]}>
	<img
		class="gbp-card-icon"
		src={getProfileIcon({ profileArt: member })}
		alt={`card ${member.id}`}
		loading="lazy"
	/>
	{
		member.rarity > 1 && (
			<img
				class="gbp-card-frame"
				src={`/assets/card-frame/${member.rarity}.webp`}
				loading="lazy"
			/>
		)
	}

	<img
		class="gbp-card-band"
		src={`/assets/bands/${member.band}.svg`}
		loading="lazy"
	/>
	<img
		class="gbp-card-attribute"
		src={`/assets/attributes/${member.attribute}.svg`}
		loading="lazy"
	/>

	<div class="gbp-card-stars">
		{
			Array.from({ length: member.rarity }, () => (
				<img
					src={`/assets/card-rarity/${(member.trainedStatus ?? member.trained) ? "trained" : "normal"}.webp`}
					loading="lazy"
				/>
			))
		}
	</div>

	{
		member.limitBreakRank && member.limitBreakRank > 0 && (
			<div class="gbp-card-limit-break">
				<img src="/assets/card-limit-break/overlay.svg" loading="lazy" />
				<span>{member.limitBreakRank}</span>
			</div>
		)
	}

	{member.level && <div class="gbp-card-level">{member.level}</div>}
</div>
