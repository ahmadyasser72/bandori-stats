---
import Icon, { type IconName } from "./icon.astro";

interface Props {
	name: IconName;
	loaderIcon?: IconName;
	class?: string;
}

const {
	name,
	loaderIcon = "svg-spinners--90-ring-with-bg",
	class: className,
} = Astro.props;
---

<Icon class:list={["htmx-indicator", className]} name={loaderIcon} />
<Icon class:list={["htmx-indicator-replace", className]} {name} />
