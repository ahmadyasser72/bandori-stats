---
import Icon, { type IconName } from "./icon.astro";

interface Props {
	name: IconName;
	loaderIcon?: IconName;
	class?: string;
}

const {
	name,
	loaderIcon = "svg-spinners--90-ring-with-bg",
	class: className,
} = Astro.props;
---

<Icon name={loaderIcon} class:list={["htmx-indicator", className]} />
<Icon {name} class:list={["htmx-indicator-replace", className]} />
