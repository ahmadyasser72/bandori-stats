---
import { DISCORD_INVITE_LINK, UMAMI_SITE_ID } from "astro:env/server";

import "~/styles/global.css";

import { Font } from "astro:assets";

import type { IconName } from "~/components/icon.astro";
import MegaMenu from "./components/mega-menu.astro";
import ThemeSelector from "./components/theme-selector.astro";

export interface PageMetadata {
	icon: IconName;
	url: string;
	label: string;
	items?: PageMetadata[];
}

export const PAGES = {
	history: {
		icon: "lucide--calendar-clock",
		url: "/history",
		label: "History",
	},
	leaderboard: {
		icon: "lucide--crown",
		url: "/leaderboard",
		label: "Leaderboard",
		items: [
			{
				icon: "lucide--bar-chart-3",
				url: "/leaderboard?tab=stats",
				label: "Stats",
			},
			{
				icon: "lucide--podium",
				url: "/leaderboard?tab=titles-event",
				label: "Titles",
				items: [
					{
						label: "Event Rank",
						url: "/leaderboard?tab=titles-event",
						icon: "lucide--calendar",
					},
					{
						label: "Song Rank",
						url: "/leaderboard?tab=titles-song",
						icon: "lucide--music",
					},
					{
						label: "Live Goals",
						url: "/leaderboard?tab=titles-goals",
						icon: "lucide--target",
					},
					{
						label: "Monthly Ranking",
						url: "/leaderboard?tab=titles-monthly",
						icon: "lucide--crown",
					},
				],
			},
			{
				icon: "lucide--calendar-days",
				url: "/leaderboard?tab=events",
				label: "Events",
			},
		],
	},
	tracker: {
		icon: "lucide--chart-area",
		url: "/tracker",
		label: "Tracker",
		items: [
			{
				icon: "lucide--calendar-days",
				url: "/tracker?tab=event",
				label: "Event",
			},
			{
				icon: "lucide--crown",
				url: "/tracker?tab=monthly",
				label: "Monthly",
			},
		],
	},
	vs: {
		icon: "lucide--flame",
		url: "/vs",
		label: "VS",
	},
} satisfies Record<string, PageMetadata>;

export const LINKS = [
	{
		icon: "line-md--github-loop",
		url: `${__GITHUB_URL__}/tree/${__GIT_HASH__}`,
		label: "Source Code",
	},
	{
		icon: "line-md--document-code",
		url: `${__GITHUB_URL__}/blob/${__GIT_HASH__}/LICENSE`,
		label: "License",
	},
	{
		icon: "line-md--discord",
		url: DISCORD_INVITE_LINK,
		label: "Discord Server",
	},
] satisfies Omit<PageMetadata, "items">[];

interface Props {
	title: string;
	page: keyof typeof PAGES | null;
	containerClass?: string;
}

const { title, page, containerClass } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />

		<script is:inline>
			document.documentElement.dataset.theme =
				localStorage.getItem("theme") ??
				(window.matchMedia("(prefers-color-scheme: dark)").matches
					? "mocha"
					: "latte");
		</script>

		<link type="image/x-icon" href="/favicon.ico" rel="icon" />
		<link type="image/png" href="/favicon-16x16.png" rel="icon" sizes="16x16" />
		<link type="image/png" href="/favicon-32x32.png" rel="icon" sizes="32x32" />
		<link type="image/png" href="/favicon-48x48.png" rel="icon" sizes="48x48" />
		<meta name="theme-color" />

		<Font cssVariable="--font-cause" preload />
		<Font cssVariable="--font-m-plus-rounded-1c" />
		<Font cssVariable="--font-kosugi-maru" />

		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>bandori-stats &bullet; {title}</title>

		<meta
			name="htmx-config"
			content="extensions:browser-indicator boostBrowserIndicator:true includeIndicatorCSS:false"
		/>

		{
			import.meta.env.PROD && UMAMI_SITE_ID && (
				<script
					data-website-id={UMAMI_SITE_ID}
					src="https://cloud.umami.is/script.js"
					defer
					is:inline
				/>
			)
		}
	</head>
	<body>
		<main
			hx-boost:inherited="transition:true"
			class:list={["container mx-auto min-h-screen p-4", containerClass]}
		>
			{
				page && (
					<div class="mb-4 flex items-center justify-between">
						<MegaMenu {page} />

						<ThemeSelector />
					</div>
				)
			}

			<slot />
		</main>
	</body>
</html>

<script>
	import htmx from "htmx.org";

	import "htmx.org/dist/ext/hx-browser-indicator";

	window.htmx = htmx;

	htmx.on("htmx:before:swap", () => {
		const openPopover = document.querySelector(":popover-open");
		if (!(openPopover instanceof HTMLElement)) return;

		openPopover.setAttribute("hx-morph-skip", "true");
		openPopover.style.setProperty("view-transition-name", "popover-open");
	});
	htmx.on("htmx:after:swap", () => {
		const openPopover = document.querySelector(":popover-open");
		if (!(openPopover instanceof HTMLElement)) return;

		openPopover.style.removeProperty("view-transition-name");
		openPopover.removeAttribute("hx-morph-skip");
	});

	let modal: HTMLDialogElement | null = null;
	htmx.onLoad(async (node) => {
		if (node.tagName !== "BOTTOM-SHEET-DIALOG-MANAGER") return;

		const dialog = node.children[0];
		if (!(dialog instanceof HTMLDialogElement)) return;

		if (!customElements.get("bottom-sheet")) {
			const { registerSheetElements } = await import("pure-web-bottom-sheet");
			registerSheetElements();
		}

		if (modal) {
			await htmx.swap({
				text: node.querySelector("bottom-sheet")!.outerHTML,
				target: modal.querySelector("bottom-sheet")!,
				swap: "outerHTML",
			});

			node.remove();
			return;
		}

		modal = dialog;
		dialog.showModal();
		dialog.addEventListener(
			"close",
			() => {
				setTimeout(() => {
					node.remove();
					modal = null;
				}, 300);
			},
			{ once: true },
		);
	});

	{
		interface Style {
			bold?: boolean;
			italic?: boolean;
			sub?: boolean;
			sup?: boolean;
			color?: string;
		}

		interface Segment {
			text: string;
			style: Style;
		}

		const TAG_REGEX = /\[([a-z]+|#[0-9a-f]{6}|[0-9a-f]{6})\]/gi;
		const parseBB = (input: string): Segment[] => {
			const segments: Segment[] = [];

			let style: Style = {};
			let color = "#ffffff";
			let colorMode = false;
			let lastIndex = 0;

			for (const match of input.matchAll(TAG_REGEX)) {
				const index = match.index!;

				if (index > lastIndex) {
					segments.push({
						text: input.slice(lastIndex, index),
						style: { ...style, ...(colorMode && { color }) },
					});
				}

				const tag = match[1].toLowerCase();

				if (/^#?[0-9a-f]{6}$/i.test(tag)) {
					color = tag.startsWith("#") ? tag : `#${tag}`;

					if (colorMode) style = { ...style, color };
				} else {
					switch (tag) {
						case "b":
							style = { ...style, bold: true };
							break;

						case "i":
							style = { ...style, italic: true };
							break;

						case "sub":
							style = { ...style, sub: true, sup: false };
							break;

						case "sup":
							style = { ...style, sup: true, sub: false };
							break;

						case "c":
							colorMode = true;
							style = { ...style, color };
							break;
					}
				}

				lastIndex = index + match[0].length;
			}

			if (lastIndex < input.length) {
				segments.push({
					text: input.slice(lastIndex),
					style: { ...style, ...(colorMode && { color }) },
				});
			}

			return segments;
		};

		htmx.onLoad((node) => {
			if (!(node instanceof HTMLElement)) return;

			node.querySelectorAll<HTMLElement>("[data-bb]").forEach((element) => {
				const segments = parseBB(element.dataset.bb!);
				element.innerHTML = segments
					.map(({ text, style }) => {
						const styles: string[] = [];
						if (style.bold) styles.push("font-weight: bold");
						if (style.italic) styles.push("font-style: italic");
						if (style.sub)
							styles.push("vertical-align: sub", "font-size: smaller");
						if (style.sup)
							styles.push("vertical-align: super", "font-size: smaller");
						if (style.color) styles.push(`color: ${style.color}`);

						return styles.length
							? `<span style="${styles.join(";")}">${text}</span>`
							: text;
					})
					.join("");
			});
		});
	}
</script>
