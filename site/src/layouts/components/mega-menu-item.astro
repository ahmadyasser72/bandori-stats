---
import IconLoader from "~/components/icon-loader.astro";
import Icon from "~/components/icon.astro";
import type { PageMetadata } from "~/layouts/base-layout.astro";

interface Props {
	item: PageMetadata;
	active: boolean;
}

const { item, active } = Astro.props;
---

{
	item.items ? (
		<li>
			<details>
				<summary class:list={[active && "menu-active"]}>
					<Icon name={item.icon} />
					{item.label}
				</summary>
				<ul>
					{item.items.map((subitem) => (
						<Astro.self active={false} item={subitem} />
					))}
				</ul>
			</details>
		</li>
	) : (
		<li>
			<a href={item.url} class:list={[active && "menu-active"]}>
				<IconLoader name={item.icon} />
				{item.label}
			</a>
		</li>
	)
}
