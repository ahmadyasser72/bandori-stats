---
import z from "zod";

import dayjs from "@bandori-stats/bestdori/date";
import {
	allKeyed,
	capitalize,
	formatNumber,
	mapValues,
	omit,
} from "@bandori-stats/bestdori/helpers";
import { and, avg, db, desc, gt, max, min, sql } from "@bandori-stats/database";
import { trackerSnapshots } from "@bandori-stats/database/schema";
import IconLoader from "~/components/icon-loader.astro";
import Icon from "~/components/icon.astro";
import SheetModal from "~/layouts/sheet-modal.astro";
import { ActivityChart } from "~/pages/tracker/charts/_activity-chart";
import { BarChart } from "~/pages/tracker/charts/_bar-chart";
import {
	countSql,
	createBaseFilter,
	createCteFilter,
	createGapsCte,
} from "./_aggregate";

export const partial = true;

const DURATIONS = ["1d", "3d", "all"] as const;

const uid = Astro.params.uid!;
const params = Astro.locals.parseQuery(
	z.object({
		kind: z.enum(["event", "monthly"]),
		id: z.coerce.number(),
		duration: z.enum(DURATIONS),
	}),
);

const { metadata, profile } = await Astro.locals.tracing.enterSpan(
	"fetch-metadata",
	async (span) => {
		span.setAttribute("uid", uid);
		span.setAttribute("kind", params.kind);
		span.setAttribute("id", params.id);

		return allKeyed({
			profile: db().query.trackerSnapshotProfiles.findFirst({
				columns: { name: true },
				where: {
					trackingFor: params.kind,
					trackingId: params.id,
					uid,
				},
			}),
			metadata:
				params.kind === "event"
					? db().query.gbpEvents.findFirst({
							columns: { startAt: true, endAt: true },
							where: { eventId: params.id },
						})
					: db().query.gbpMonthlyRankings.findFirst({
							columns: { startAt: true, endAt: true },
							where: { monthlyRankingId: params.id },
						}),
		});
	},
);

if (!metadata) return new Response(null, { status: 404 });

let after: dayjs.Dayjs | null;
if (params.duration === "1d") after = dayjs().subtract(1, "day");
else if (params.duration === "3d") after = dayjs().subtract(3, "day");
else after = null;

const startAt = dayjs(metadata.startAt).startOf("hour").valueOf();
after = after && after.isAfter(startAt) ? after : dayjs(startAt);
const isPastData = dayjs().isAfter(metadata.endAt);

const baseFilter = createBaseFilter(params.kind, params.id, uid);

const { gameStatistics, gameByHours, gameByPoints } =
	await Astro.locals.tracing.enterSpan("fetch-statistics", (span) => {
		span.setAttribute("uid", uid);
		span.setAttribute("kind", params.kind);
		span.setAttribute("id", params.id);
		span.setAttribute("after", after.toISOString());

		const gapsCte = createGapsCte(baseFilter);
		const cteFilter = createCteFilter(params.kind, gapsCte, after.toDate());

		return allKeyed({
			gameStatistics: Astro.locals.tracing.enterSpan(
				"fetch-game-statistics",
				async () => {
					const statistics = await db()
						.with(gapsCte)
						.select({
							gamesTotal: countSql,
							minPoints: min(gapsCte.delta),
							maxPoints: max(gapsCte.delta),
							meanPoints: avg(gapsCte.delta),
							medianPoints: sql<number>`MEDIAN(${gapsCte.delta})`,
							averageMinutesPerGame: avg(
								sql`CASE WHEN ${gapsCte.gapMinutes} <= 10 THEN ${gapsCte.gapMinutes} ELSE NULL END`,
							),

							oldestPoint: min(gapsCte.point),
							latestPoint: max(gapsCte.point),
							latestTimestamp: max(gapsCte.timestamp),
							oldestTimestamp: min(gapsCte.timestamp),
						})
						.from(gapsCte)
						.where(cteFilter)
						.then(([results]) =>
							mapValues(results, (value) => Number(value ?? 0)),
						);

					return {
						...statistics,
						pointsPerHour:
							(statistics.latestPoint - statistics.oldestPoint) /
							dayjs(statistics.latestTimestamp).diff(
								statistics.oldestTimestamp,
								"hours",
								true,
							),
					};
				},
			),
			gameByHours: Astro.locals.tracing.enterSpan(
				"fetch-game-by-hours",
				async () => {
					const snapshotHour = sql<number>`CAST(${trackerSnapshots.timestamp} / 3600000 AS INTEGER) * 3600000`;
					const aggregatedCounts = await db()
						.select({ hour: snapshotHour, count: countSql })
						.from(trackerSnapshots)
						.where(
							and(baseFilter, gt(trackerSnapshots.timestamp, after.toDate())),
						)
						.groupBy(snapshotHour);

					const countByHours = new Map(
						aggregatedCounts.map(({ hour, count }) => [hour, count]),
					);

					return Array.from(
						{
							length: dayjs(metadata.endAt)
								.startOf("hour")
								.add(1, "hour")
								.diff(metadata.startAt, "hours"),
						},
						(_, idx): [number, number] => {
							const timestamp = startAt + idx * 60 * 60 * 1000;
							return [timestamp, countByHours.get(timestamp) ?? 0];
						},
					);
				},
			),
			gameByPoints: Astro.locals.tracing.enterSpan(
				"fetch-game-by-points",
				async () => {
					const minPoints = await db()
						.with(gapsCte)
						.select({ minPoints: min(gapsCte.delta) })
						.from(gapsCte)
						.where(cteFilter)
						.then(([{ minPoints }]) => Number(minPoints ?? 0));
					const deltaQuery = db()
						.with(gapsCte)
						.select({
							delta:
								minPoints <= 50
									? gapsCte.delta
									: sql<number>`CAST(ROUND((${gapsCte.delta}) / 100.0) * 100 AS INTEGER)`.as(
											"delta",
										),
						})
						.from(gapsCte)
						.where(cteFilter)
						.as("delta_query");

					return db()
						.select({ delta: deltaQuery.delta, count: countSql })
						.from(deltaQuery)
						.groupBy(deltaQuery.delta)
						.where(gt(deltaQuery.delta, 0))
						.orderBy(desc(countSql), desc(deltaQuery.delta))
						.then((rows) =>
							rows.map(({ delta, count }): [number, number] => [delta, count]),
						);
				},
			),
		});
	});

const {
	gamesTotal,
	minPoints,
	maxPoints,
	meanPoints,
	medianPoints,
	averageMinutesPerGame,
	pointsPerHour,
} = gameStatistics;

if (Astro.cache.enabled)
	Astro.cache.set(isPastData ? { maxAge: 60 * 60 } : { maxAge: 30, swr: 30 });
---

<SheetModal class="mx-auto max-w-2xl">
	<h2 class="text-center text-2xl font-medium">
		{
			profile
				? `${profile.name}: Statistics (${params.duration})`
				: "Player not found"
		}
	</h2>

	{
		!isPastData && (
			<fieldset
				hx-vals:inherited={JSON.stringify(omit(params, ["duration"]))}
				class="tabs mt-4 w-full tabs-sm text-accent"
				role="tablist"
			>
				{DURATIONS.map((duration) => (
					<label class="tab h-16 flex-col hover:text-accent max-md:flex-1 md:px-12">
						<input
							hx-get={Astro.url.pathname}
							hx-disable="closest .tabs"
							hx-swap="after"
							hx-target="main"
							data-umami-event="tracker-statistics-duration"
							data-umami-event-duration={duration}
							data-umami-event-kind={params.kind}
							data-umami-event-player={profile?.name}
							name="duration"
							type="radio"
							value={duration}
							checked={duration === params.duration}
						/>
						<IconLoader class="size-5" name="lucide--clock" />
						{capitalize(duration)}
					</label>
				))}
			</fieldset>
		)
	}

	<div class="mt-4 flex flex-wrap justify-center gap-x-1 gap-y-0.5">
		<div class="badge badge-soft badge-lg badge-primary">
			{gamesTotal} Games
		</div>
		<div class="badge badge-soft badge-lg badge-accent">
			Average: {formatNumber(meanPoints, { positiveSign: true })}
		</div>
		<div class="badge badge-soft badge-lg badge-accent">
			Median: {formatNumber(medianPoints, { positiveSign: true })}
		</div>
		<div class="badge badge-soft badge-lg badge-accent">
			Min: {formatNumber(minPoints, { positiveSign: true })}
		</div>
		<div class="badge badge-soft badge-lg badge-accent">
			Max: {formatNumber(maxPoints, { positiveSign: true })}
		</div>
		<div class="badge badge-soft badge-lg badge-accent">
			{formatNumber(pointsPerHour, { positiveSign: true })} Pts/hour{
				params.duration !== "all" && " (estimated)"
			}
		</div>
		<div class="badge badge-soft badge-lg badge-accent">
			{formatNumber(averageMinutesPerGame)} Minutes/game (average)
		</div>
	</div>

	{
		params.duration === "all" ? (
			<ActivityChart
				client:only="preact"
				data={gameByHours}
				label="Activity heatmap"
			>
				<div class="mt-8 w-full" slot="fallback">
					<h3 class="text-center text-xl font-medium">
						<Icon
							class="mr-1 align-[-2px]"
							name="svg-spinners--90-ring-with-bg"
						/>
						Activity heatmap
					</h3>
					<div class="my-2 h-64 w-full skeleton" />
				</div>
			</ActivityChart>
		) : (
			<BarChart
				client:only="preact"
				color="var(--color-primary)"
				data={gameByHours}
				hourly
				label="Active hours"
			>
				<div class="mt-8 w-full" slot="fallback">
					<h3 class="text-center text-xl font-medium">
						<Icon
							class="mr-1 align-[-2px]"
							name="svg-spinners--90-ring-with-bg"
						/>
						Active hours
					</h3>
					<div class="my-2 h-64 w-full skeleton" />
				</div>
			</BarChart>
		)
	}

	<BarChart
		client:only="preact"
		color="var(--color-accent)"
		data={gameByPoints}
		label="Most obtained points"
	>
		<div class="mt-8 w-full" slot="fallback">
			<h3 class="text-center text-xl font-medium">
				<Icon class="mr-1 align-[-2px]" name="svg-spinners--90-ring-with-bg" />

				Most obtained points
			</h3>
			<div class="my-2 h-64 w-full skeleton"></div>
		</div>
	</BarChart>
</SheetModal>
