---
import z from "zod";

import { GBP_TIMEZONE } from "@bandori-stats/bestdori/constants";
import dayjs from "@bandori-stats/bestdori/date";
import {
	allKeyed,
	capitalize,
	formatNumber,
	mapValues,
	omit,
	sumBy,
} from "@bandori-stats/bestdori/helpers";
import {
	and,
	asc,
	avg,
	db,
	desc,
	eq,
	gt,
	gte,
	lte,
	max,
	min,
	sql,
} from "@bandori-stats/database";
import { trackerSnapshots } from "@bandori-stats/database/schema";
import IconLoader from "~/components/icon-loader.astro";
import Icon from "~/components/icon.astro";
import SheetModal from "~/layouts/sheet-modal.astro";
import { ActivityChart } from "~/pages/tracker/charts/_activity-chart";
import { BarChart } from "~/pages/tracker/charts/_bar-chart";

export const partial = true;

const DURATIONS = ["1d", "3d", "all"] as const;

const uid = Astro.params.uid!;
const params = Astro.locals.parseQuery(
	z.object({
		kind: z.enum(["event", "monthly"]),
		id: z.coerce.number(),
		duration: z.enum(DURATIONS),
	}),
);

const clientTimezone =
	Astro.request.headers.get("client-timezone") ?? GBP_TIMEZONE;
Astro.response.headers.append("vary", "client-timezone");
const now = dayjs().tz(clientTimezone);

const { metadata, profile } = await Astro.locals.tracing.enterSpan(
	"fetch-metadata",
	async (span) => {
		span.setAttribute("uid", uid);
		span.setAttribute("kind", params.kind);
		span.setAttribute("id", params.id);

		return allKeyed({
			profile: db().query.trackerSnapshotProfiles.findFirst({
				columns: { name: true },
				where: {
					trackingFor: params.kind,
					trackingId: params.id,
					uid,
				},
			}),
			metadata:
				params.kind === "event"
					? db().query.gbpEvents.findFirst({
							columns: { startAt: true, endAt: true },
							where: { eventId: params.id },
						})
					: db().query.gbpMonthlyRankings.findFirst({
							columns: { startAt: true, endAt: true },
							where: { monthlyRankingId: params.id },
						}),
		});
	},
);

if (!metadata) return new Response(null, { status: 404 });

let after: dayjs.Dayjs | null;
if (params.duration === "1d") after = dayjs().subtract(1, "day");
else if (params.duration === "3d") after = dayjs().subtract(3, "day");
else after = null;

const startAt = dayjs(metadata.startAt).startOf("hour");
const since = after && startAt.isBefore(after) ? after : startAt;

const baseFilter = and(
	eq(trackerSnapshots.trackingFor, params.kind),
	eq(trackerSnapshots.trackingId, params.id),
	eq(trackerSnapshots.uid, uid),
);

const { gameStatistics, gameByHours, gameByPoints } =
	await Astro.locals.tracing.enterSpan("fetch-statistics", (span) => {
		span.setAttribute("uid", uid);
		span.setAttribute("kind", params.kind);
		span.setAttribute("id", params.id);
		span.setAttribute("timezone", clientTimezone);
		span.setAttribute("after", since.toISOString());

		const countSql = sql<number>`COUNT(*)`;
		const deltaSql = sql<number>`${trackerSnapshots.point} - LAG(${trackerSnapshots.point}, 1, ${trackerSnapshots.point}) OVER (ORDER BY ${asc(trackerSnapshots.id)})`;
		const gapsCte = db()
			.$with("gaps")
			.as(
				db()
					.select({
						point: deltaSql.as("point"),
						gapMinutes:
							sql<number>`(${trackerSnapshots.timestamp} - LAG(${trackerSnapshots.timestamp}) OVER (ORDER BY ${asc(trackerSnapshots.id)})) / 60000.0`.as(
								"gap_minutes",
							),
						timestamp: trackerSnapshots.timestamp,
					})
					.from(trackerSnapshots)
					.where(baseFilter),
			);

		const cteFilter = and(
			gte(gapsCte.timestamp, since.toDate()),
			gt(gapsCte.point, 0),
			lte(gapsCte.point, params.kind === "monthly" ? 20 : 100_000),
		);

		return allKeyed({
			gameStatistics: Astro.locals.tracing.enterSpan(
				"fetch-game-statistics",
				async () => {
					const [statistics] = await db()
						.with(gapsCte)
						.select({
							gamesTotal: countSql,
							minPoints: min(gapsCte.point),
							maxPoints: max(gapsCte.point),
							meanPoints: avg(gapsCte.point),
							medianPoints: sql<number>`MEDIAN(${gapsCte.point})`,
							averageMinutesPerGame: avg(
								sql`CASE WHEN ${gapsCte.gapMinutes} <= 30 THEN ${gapsCte.gapMinutes} ELSE NULL END`,
							),

							latestPoint: sql<number>`(SELECT ${trackerSnapshots.point} FROM ${trackerSnapshots} WHERE ${cteFilter} ORDER BY ${trackerSnapshots.timestamp} DESC LIMIT 1)`,
							latestTimestamp: sql<number>`(SELECT ${trackerSnapshots.timestamp} FROM ${trackerSnapshots} WHERE ${cteFilter} ORDER BY ${trackerSnapshots.timestamp} DESC LIMIT 1)`,
							oldestPoint: sql<number>`(SELECT ${trackerSnapshots.point} FROM ${trackerSnapshots} WHERE ${cteFilter} ORDER BY ${trackerSnapshots.timestamp} ASC LIMIT 1)`,
							oldestTimestamp: sql<number>`(SELECT ${trackerSnapshots.timestamp} FROM ${trackerSnapshots} WHERE ${cteFilter} ORDER BY ${trackerSnapshots.timestamp} ASC LIMIT 1)`,
						})
						.from(gapsCte)
						.where(cteFilter);

					return {
						...mapValues(statistics, (value) => Number(value ?? 0)),
						pointsPerHour:
							(statistics.latestPoint - statistics.oldestPoint) /
							dayjs(statistics.latestTimestamp).diff(
								statistics.oldestTimestamp,
								"hours",
								true,
							),
					};
				},
			),
			gameByHours: Astro.locals.tracing.enterSpan(
				"fetch-game-by-hours",
				async () => {
					const snapshotHour = sql<number>`CAST(${trackerSnapshots.timestamp} / 3600000 AS INTEGER) * 3600000`;
					const aggregatedCounts = await db()
						.select({ hour: snapshotHour, count: countSql })
						.from(trackerSnapshots)
						.where(
							and(baseFilter, gt(trackerSnapshots.timestamp, since.toDate())),
						)
						.groupBy(snapshotHour);

					const countByHours = new Map(
						aggregatedCounts.map(({ hour, count }) => [hour, count]),
					);

					return Array.from(
						{
							length: dayjs(metadata.endAt)
								.endOf("hour")
								.diff(metadata.startAt, "hours"),
						},
						(_, idx): [number, number] => {
							const timestamp = startAt.add(idx, "hours").valueOf();
							return [timestamp, countByHours.get(timestamp) ?? 0];
						},
					);
				},
			),
			gameByPoints: Astro.locals.tracing.enterSpan(
				"fetch-game-by-points",
				async () => {
					const minPoints = await db()
						.with(gapsCte)
						.select({ minPoints: min(gapsCte.point) })
						.from(gapsCte)
						.where(cteFilter)
						.then(([{ minPoints }]) => Number(minPoints ?? 0));
					const deltaQuery = db()
						.with(gapsCte)
						.select({
							delta:
								minPoints <= 50
									? gapsCte.point
									: sql<number>`CAST(ROUND((${gapsCte.point}) / 100.0) * 100 AS INTEGER)`.as(
											"delta",
										),
						})
						.from(gapsCte)
						.where(cteFilter)
						.as("delta_query");

					return db()
						.select({ delta: deltaQuery.delta, count: countSql })
						.from(deltaQuery)
						.groupBy(deltaQuery.delta)
						.where(sql`${deltaQuery.delta} > 0`)
						.orderBy(desc(countSql), desc(deltaQuery.delta))
						.then((rows) =>
							rows.map(({ delta, count }): [string, number] => [
								`${minPoints > 50 ? "~" : ""}${formatNumber(delta)}`,
								count,
							]),
						);
				},
			),
		});
	});

const {
	gamesTotal,
	minPoints,
	maxPoints,
	meanPoints,
	medianPoints,
	averageMinutesPerGame,
	pointsPerHour,
} = gameStatistics;

if (Astro.cache.enabled) Astro.cache.set({ maxAge: 30, swr: 30 });
---

<SheetModal class="mx-auto max-w-2xl">
	<h2 class="text-center text-2xl font-medium">
		{
			profile
				? `${profile.name}: Statistics (${params.duration})`
				: "Player not found"
		}
	</h2>

	<fieldset
		hx-vals:inherited={JSON.stringify(omit(params, ["duration"]))}
		class="tabs mt-4 w-full tabs-sm text-accent"
		role="tablist"
	>
		{
			DURATIONS.map((duration) => (
				<label class="tab h-16 flex-col hover:text-accent max-md:flex-1 md:px-12">
					<input
						hx-get={Astro.url.pathname}
						hx-disable="closest .tabs"
						hx-swap="after"
						hx-target="main"
						data-umami-event="tracker-statistics-duration"
						data-umami-event-duration={duration}
						data-umami-event-kind={params.kind}
						data-umami-event-player={profile?.name}
						name="duration"
						type="radio"
						value={duration}
						checked={duration === params.duration}
					/>
					<IconLoader class="size-5" name="lucide--clock" />
					{capitalize(duration)}
				</label>
			))
		}
	</fieldset>

	<div class="mt-4 flex flex-wrap justify-center gap-x-1 gap-y-0.5">
		<div class="badge badge-soft badge-lg badge-accent">
			{gamesTotal} Games
		</div>
		<div class="badge badge-soft badge-lg badge-info">
			Average: {formatNumber(meanPoints, { positiveSign: true })}
		</div>
		<div class="badge badge-soft badge-lg badge-info">
			Median: {formatNumber(medianPoints, { positiveSign: true })}
		</div>
		<div class="badge badge-soft badge-lg badge-info">
			Min: {formatNumber(minPoints, { positiveSign: true })}
		</div>
		<div class="badge badge-soft badge-lg badge-info">
			Max: {formatNumber(maxPoints, { positiveSign: true })}
		</div>
		<div class="badge badge-soft badge-lg badge-info">
			{formatNumber(pointsPerHour, { positiveSign: true })} Pts/hour{
				params.duration !== "all" && " (estimated)"
			}
		</div>
		<div class="badge badge-soft badge-lg badge-info">
			{formatNumber(averageMinutesPerGame)} Minutes/game (average)
		</div>
	</div>

	{
		params.duration === "all" ? (
			<ActivityChart
				client:only="preact"
				data={gameByHours}
				label="Activity heatmap"
			>
				<div class="mt-8 w-full" slot="fallback">
					<h3 class="text-center text-xl font-medium">
						<Icon
							class="mr-1 align-[-2px]"
							name="svg-spinners--90-ring-with-bg"
						/>
						Activity heatmap
					</h3>
					<div class="my-2 h-64 w-full skeleton" />
				</div>
			</ActivityChart>
		) : (
			<BarChart
				client:only="preact"
				color="var(--color-primary)"
				data={Array.from({ length: 24 }, (_, hour) => [
					now.set("hour", hour).startOf("hour").format("hh:mm A"),
					sumBy(gameByHours, ([timestamp, value]) =>
						dayjs.tz(timestamp, clientTimezone).get("hour") === hour
							? value
							: 0,
					),
				])}
				label="Active hours"
			>
				<div class="mt-8 w-full" slot="fallback">
					<h3 class="text-center text-xl font-medium">
						<Icon
							class="mr-1 align-[-2px]"
							name="svg-spinners--90-ring-with-bg"
						/>
						Active hours
					</h3>
					<div class="my-2 h-64 w-full skeleton" />
				</div>
			</BarChart>
		)
	}

	<BarChart
		client:only="preact"
		color="var(--color-accent)"
		data={gameByPoints}
		label="Most obtained points"
	>
		<div class="mt-8 w-full" slot="fallback">
			<h3 class="text-center text-xl font-medium">
				<Icon class="mr-1 align-[-2px]" name="svg-spinners--90-ring-with-bg" />

				Most obtained points
			</h3>
			<div class="my-2 h-64 w-full skeleton"></div>
		</div>
	</BarChart>
</SheetModal>
