---
import z from "zod";

import { GBP_TIMEZONE } from "@bandori-stats/bestdori/constants";
import dayjs from "@bandori-stats/bestdori/date";
import {
	countBy,
	formatNumber,
	mean,
	median,
} from "@bandori-stats/bestdori/helpers";
import { db } from "@bandori-stats/database";
import Icon from "~/components/icon.astro";
import SheetModal from "~/layouts/sheet-modal.astro";
import {
	StatsBarChart,
	type StatsBarChartProps,
} from "~/pages/tracker/charts/_stats-bar-chart";

export const partial = true;

const uid = Astro.params.uid!;
const params = Astro.locals.parseQuery(
	z.object({
		kind: z.enum(["event", "monthly"]),
		id: z.coerce.number(),
	}),
);

const clientTimezone =
	Astro.request.headers.get("client-timezone") ?? GBP_TIMEZONE;
Astro.response.headers.append("vary", "client-timezone");
const now = dayjs().tz(clientTimezone);

const snapshots = await Astro.locals.tracing.enterSpan(
	"fetch-snapshots",
	async (span) => {
		span.setAttribute("uid", uid);
		span.setAttribute("kind", params.kind);
		span.setAttribute("id", params.id);

		const rows = await db().query.trackerSnapshots.findMany({
			columns: { name: true, point: true, timestamp: true },
			where: {
				trackingFor: params.kind,
				trackingId: params.id,
				uid,
			},
			orderBy: { id: "desc" },
		});

		return rows.filter(
			({ point }, idx, snapshots) => point !== snapshots.at(idx + 1)?.point,
		);
	},
);

const gameByHours = Object.entries({
	...Object.fromEntries(
		Array.from({ length: 24 }, (_, idx): [number, number] => [idx, 0]),
	),
	...countBy(snapshots, ({ timestamp }) =>
		dayjs.tz(timestamp, clientTimezone).get("hour"),
	),
}).map(([hour, count]): [string, number] => [
	now.set("hour", Number(hour)).startOf("hour").format("hh:mm A"),
	count,
]);
const gameByDayOfWeek = Object.entries({
	...Object.fromEntries(
		Array.from({ length: 7 }, (_, idx): [number, number] => [idx, 0]),
	),
	...countBy(snapshots, ({ timestamp }) =>
		dayjs.tz(timestamp, clientTimezone).get("day"),
	),
}).map(([day, count]): [string, number] => [
	now.set("day", Number(day)).format("dddd"),
	count,
]);

const rawPoints = snapshots
	.slice(0, -1)
	.map(({ point }, idx) => point - snapshots[idx + 1].point);
const outlierThreshold = mean(rawPoints) * 3;

const points = rawPoints.filter((point) => point <= outlierThreshold);
const outlierCount = rawPoints.length - points.length;

const minPoints = Math.min(...points);
const gameByPoints = Object.entries(
	countBy(points, (point) =>
		minPoints <= 50 ? point : Math.round(point / 100) * 100,
	),
)
	.sort(
		([aPoint, aCount], [bPoint, bCount]) =>
			bCount - aCount || Number(bPoint) - Number(aPoint),
	)
	.map(([point, count]): [string, number] => [
		`${minPoints > 50 ? "~" : ""}${formatNumber(Number(point))}`,
		count,
	]);

const pointsPerHour = (() => {
	const [first, last] = [snapshots[0], snapshots.at(-1)!];
	const pointsGained = first.point - last.point;
	const duration = dayjs(first.timestamp).diff(last.timestamp, "hour", true);
	return pointsGained / duration;
})();

const averageMinutesPerGame = (() => {
	const gaps = snapshots
		.slice(0, -1)
		.map(({ timestamp }, idx) =>
			dayjs(timestamp).diff(snapshots[idx + 1].timestamp, "minute"),
		)
		.filter((gap) => gap <= 30);
	return mean(gaps);
})();

const charts = [
	{
		data: gameByPoints,
		label: "Most obtained points",
		color: "var(--color-primary)",
	},
	{
		data: gameByHours,
		label: "Active hours",
		color: "var(--color-accent)",
	},
	{
		data: gameByDayOfWeek,
		label: "Active day of week",
		color: "var(--color-accent)",
	},
] satisfies StatsBarChartProps[];

if (Astro.cache.enabled) Astro.cache.set({ maxAge: 30, swr: 30 });
---

<SheetModal class="mx-auto max-w-2xl">
	<h2 class="text-center text-2xl font-medium">
		{snapshots[0].name}: Statistics
	</h2>

	<div class="mt-4 flex flex-wrap justify-center gap-x-1 gap-y-0.5">
		<div class="badge badge-soft badge-lg badge-accent">
			{snapshots.length - 1} Games
		</div>
		<div class="badge badge-soft badge-lg badge-info">
			Average: {formatNumber(Math.round(mean(points)), { positiveSign: true })}
		</div>
		<div class="badge badge-soft badge-lg badge-info">
			Median: {formatNumber(median(points), { positiveSign: true })}
		</div>
		<div class="badge badge-soft badge-lg badge-info">
			Min: {formatNumber(minPoints, { positiveSign: true })}
		</div>
		<div class="badge badge-soft badge-lg badge-info">
			Max: {formatNumber(Math.max(...points), { positiveSign: true })}
		</div>
		<div class="badge badge-soft badge-lg badge-info">
			{formatNumber(pointsPerHour, { positiveSign: true })} Pts/hour (estimated)
		</div>
		<div class="badge badge-soft badge-lg badge-info">
			{formatNumber(averageMinutesPerGame)} Minutes/game (average)
		</div>
		{
			outlierCount > 0 && (
				<div
					class="tooltip badge badge-soft badge-lg tooltip-warning badge-warning before:max-w-32"
					data-tip="Point jumps during untracked gaps are excluded from stats"
				>
					{outlierCount} gap{outlierCount > 1 && "s"} excluded
				</div>
			)
		}
	</div>

	{
		charts.map((props) => (
			<StatsBarChart {...props} client:only="preact">
				<div class="mt-8 w-full" slot="fallback">
					<h3 class="text-center text-xl font-medium">
						<Icon
							class="mr-1 align-[-2px]"
							name="svg-spinners--90-ring-with-bg"
						/>

						{props.label}
					</h3>
					<div class="my-2 h-64 w-full skeleton" />
				</div>
			</StatsBarChart>
		))
	}
</SheetModal>
