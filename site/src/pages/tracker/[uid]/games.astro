---
import { allKeyed, omit } from "es-toolkit";
import z from "zod";

import dayjs, { formatDuration } from "@bandori-stats/bestdori/date";
import { formatNumber, stripBB } from "@bandori-stats/bestdori/helpers";
import { db, desc } from "@bandori-stats/database";
import IconLoader from "~/components/icon-loader.astro";
import Icon from "~/components/icon.astro";
import SheetModal from "~/layouts/sheet-modal.astro";
import {
	createBaseFilter,
	createCteFilter,
	createGapsCte,
	fetchStatistics,
	outlierCap,
} from "./_aggregate";
import { DurationCalendar } from "./_duration-calendar";

export const partial = true;

const DURATIONS = ["1h", "3h", "6h", "12h"] as const;

const uid = Astro.params.uid!;
const params = Astro.locals.parseQuery(
	z.object({
		kind: z.enum(["event", "monthly"]),
		id: z.coerce.number(),
		duration: z.union([
			z.enum(DURATIONS),
			z.templateLiteral([z.iso.date(), ":", z.iso.date()]),
		]),
	}),
);

const { metadata, profile } = await Astro.locals.tracing.enterSpan(
	"fetch-metadata",
	async (span) => {
		span.setAttribute("uid", uid);
		span.setAttribute("kind", params.kind);
		span.setAttribute("id", params.id);

		return allKeyed({
			profile: db().query.trackerSnapshotProfiles.findFirst({
				columns: { name: true },
				where: {
					trackingFor: params.kind,
					trackingId: params.id,
					uid,
				},
			}),
			metadata:
				params.kind === "event"
					? db().query.gbpEvents.findFirst({
							columns: { startAt: true, endAt: true },
							where: { eventId: params.id },
						})
					: db().query.gbpMonthlyRankings.findFirst({
							columns: { startAt: true, endAt: true },
							where: { monthlyRankingId: params.id },
						}),
		});
	},
);

if (!metadata) return new Response(null, { status: 404 });

let from: dayjs.Dayjs;
let to = dayjs(metadata.endAt);
if (params.duration === "1h") from = dayjs().subtract(1, "hour");
else if (params.duration === "3h") from = dayjs().subtract(3, "hour");
else if (params.duration === "6h") from = dayjs().subtract(6, "hour");
else if (params.duration === "12h") from = dayjs().subtract(12, "hour");
else {
	const [left, right] = params.duration.split(":");
	from = dayjs(left).startOf("day");
	to = dayjs(right).endOf("day");
}

const { statistics, games } = await Astro.locals.tracing.enterSpan(
	"fetch-games",
	(span) => {
		span.setAttribute("uid", uid);
		span.setAttribute("kind", params.kind);
		span.setAttribute("id", params.id);
		span.setAttribute("duration", params.duration);
		span.setAttribute("from", from.toISOString());
		span.setAttribute("to", to.toISOString());

		const baseFilter = createBaseFilter(params.kind, params.id, uid);
		const gapsCte = createGapsCte(baseFilter);
		const cteFilter = createCteFilter(params.kind, gapsCte, from, to);
		return allKeyed({
			statistics: Astro.locals.tracing.enterSpan("fetch-game-statistics", () =>
				fetchStatistics(gapsCte, cteFilter),
			),
			games: Astro.locals.tracing.enterSpan("fetch-game-list", () =>
				db()
					.with(gapsCte)
					.select({
						point: gapsCte.point,
						timestamp: gapsCte.timestamp,
						delta: gapsCte.delta,
					})
					.from(gapsCte)
					.where(cteFilter)
					.orderBy(desc(gapsCte.timestamp)),
			),
		});
	},
);

const {
	gamesTotal,
	minPoints,
	maxPoints,
	meanPoints,
	medianPoints,
	averageMinutesPerGame,
	pointsPerHour,
} = statistics;
const isPastData = dayjs().isAfter(metadata.endAt);

if (Astro.cache.enabled)
	Astro.cache.set(isPastData ? { maxAge: 60 * 60 } : { maxAge: 30, swr: 30 });
---

<SheetModal>
	<h2 class="text-center text-2xl font-medium">
		{
			profile ? (
				<>
					<span data-bb={profile.name}>{stripBB(profile.name)}</span> &mdash;
					Games
				</>
			) : (
				"Player not found"
			)
		}
	</h2>
	<span class="text-center font-mono text-sm text-base-content/67"
		>({params.duration})</span
	>

	<fieldset
		hx-vals:inherited={JSON.stringify(omit(params, ["duration"]))}
		class="tabs mt-4 w-full tabs-sm text-accent"
		role="tablist"
	>
		{
			(isPastData ? ["?"] : [...DURATIONS, "?"]).map((duration) => (
				<label
					class="tab h-16 flex-col hover:text-accent max-md:flex-1 md:px-12"
					{...(duration === "?" && {
						onclick: "this.parentNode.lastElementChild.togglePopover()",
						style: "anchor-name: --anchor-duration-calendar",
					})}
				>
					{duration !== "?" && (
						<input
							hx-get={Astro.url.pathname}
							hx-disable="closest .tabs"
							hx-swap="after"
							hx-target="main"
							data-umami-event="tracker-games-duration"
							data-umami-event-duration={duration}
							data-umami-event-kind={params.kind}
							data-umami-event-player={stripBB(profile?.name)}
							name="duration"
							type="radio"
							value={duration}
							checked={duration === params.duration}
						/>
					)}
					<IconLoader class="size-5" name="lucide--clock" />
					{duration}
				</label>
			))
		}

		<div
			class:list={[
				"dropdown text-base-content",
				isPastData ? "dropdown-center" : "dropdown-end",
				games.length <= 10 && "dropdown-top",
			]}
			popover
			style="position-anchor: --anchor-duration-calendar"
		>
			<div
				hx-indicator:inherited="#duration-calendar-loader"
				hx-preserve="true"
				class="relative flex min-h-70 min-w-75 justify-center"
				id="duration-calendar"
			>
				<DurationCalendar
					client:only="preact"
					dateMax={metadata.endAt}
					dateMin={metadata.startAt}
					url={Astro.url}
				/>
				<div
					class="htmx-indicator absolute inset-0 bg-base-100/67"
					id="duration-calendar-loader"
				>
					<Icon
						class="absolute center size-32"
						name="svg-spinners--bars-scale"
					/>
				</div>
			</div>
		</div>
	</fieldset>

	<div class="mt-4 flex max-w-4/5 flex-wrap justify-center gap-x-1 gap-y-0.5">
		{
			params.duration !== "1h" && (
				<div class="badge badge-soft badge-md badge-primary">
					{formatNumber(gamesTotal / dayjs().diff(from, "hours"))} Games/hour
				</div>
			)
		}

		<div class="badge badge-soft badge-md badge-primary">
			{gamesTotal} Games
		</div>
		<div class="badge badge-soft badge-md badge-accent">
			Average:{" "}
			{formatNumber(meanPoints, { positiveSign: true })}
		</div>
		<div class="badge badge-soft badge-md badge-accent">
			Median:{" "}
			{formatNumber(medianPoints, { positiveSign: true })}
		</div>
		<div class="badge badge-soft badge-md badge-accent">
			Min: {formatNumber(minPoints, { positiveSign: true })}
		</div>
		<div class="badge badge-soft badge-md badge-accent">
			Max: {formatNumber(maxPoints, { positiveSign: true })}
		</div>
		<div class="badge badge-soft badge-md badge-accent">
			{formatNumber(pointsPerHour, { positiveSign: true })}{" "}
			Pts/hour (estimated)
		</div>
		<div class="badge badge-soft badge-md badge-accent">
			{formatNumber(averageMinutesPerGame)} Minutes/game (average)
		</div>
	</div>

	<ul
		class="timeline timeline-vertical mt-2 max-h-[60vh] w-full max-w-120 overflow-y-auto"
	>
		{
			games.map(({ point, timestamp, delta }, idx) => (
				<li>
					{idx > 0 && <hr class="bg-neutral" />}
					<div class="timeline-start font-mono">
						{formatDuration({ from: timestamp })}
					</div>
					<div class="timeline-end">
						<div class="inline-flex items-center font-semibold">
							{formatNumber(point)}
							<span
								class:list={[
									"ml-1 badge px-1.5 badge-xs",
									delta > outlierCap(params.kind)
										? "badge-warning"
										: "badge-success",
								]}
							>
								{formatNumber(delta, { positiveSign: true })}
							</span>

							{delta > outlierCap(params.kind) && (
								<span
									class="tooltip tooltip-end ml-1 badge badge-xs tooltip-warning badge-warning before:max-w-32"
									data-tip="Likely accumulated while untracked"
								>
									gap
								</span>
							)}
						</div>
					</div>
					{idx < games.length - 1 && <hr class="bg-neutral" />}
				</li>
			))
		}
	</ul>

	{
		gamesTotal === 0 && (
			<div class="flex items-center justify-center gap-2 py-16">
				<Icon class="size-10" name="lucide--x" />
				<span class="text-lg font-medium">No games found</span>
			</div>
		)
	}
</SheetModal>
