---
import { UMAMI_SITE_ID } from "astro:env/server";

import z from "zod";

import dayjs, { formatDuration } from "@bandori-stats/bestdori/date";
import {
	allKeyed,
	formatNumber,
	mapValues,
	omit,
} from "@bandori-stats/bestdori/helpers";
import {
	and,
	asc,
	avg,
	db,
	desc,
	eq,
	gt,
	gte,
	lte,
	max,
	min,
	sql,
} from "@bandori-stats/database";
import { trackerSnapshots } from "@bandori-stats/database/schema";
import IconLoader from "~/components/icon-loader.astro";
import Icon from "~/components/icon.astro";
import SheetModal from "~/layouts/sheet-modal.astro";

export const partial = true;

const DURATIONS = ["1h", "3h", "6h", "12h", "1d"] as const;

const uid = Astro.params.uid!;
const params = Astro.locals.parseQuery(
	z.object({
		kind: z.enum(["event", "monthly"]),
		id: z.coerce.number(),
		duration: z.enum(DURATIONS),
	}),
);

const outlierCap = params.kind === "monthly" ? 20 : 100_000;

let after: dayjs.Dayjs;
if (params.duration === "1h") after = dayjs().subtract(1, "hour");
else if (params.duration === "3h") after = dayjs().subtract(3, "hour");
else if (params.duration === "6h") after = dayjs().subtract(6, "hour");
else if (params.duration === "12h") after = dayjs().subtract(12, "hour");
else after = dayjs().subtract(1, "day");

const baseFilter = and(
	eq(trackerSnapshots.trackingFor, params.kind),
	eq(trackerSnapshots.trackingId, params.id),
	eq(trackerSnapshots.uid, uid),
);

const { profile, statistics, games } = await Astro.locals.tracing.enterSpan(
	"fetch-recent-games",
	(span) => {
		span.setAttribute("uid", uid);
		span.setAttribute("kind", params.kind);
		span.setAttribute("id", params.id);
		span.setAttribute("duration", params.duration);
		span.setAttribute("after", after.toISOString());

		const deltaSql = sql<number>`${trackerSnapshots.point} - LAG(${trackerSnapshots.point}, 1, ${trackerSnapshots.point}) OVER (ORDER BY ${asc(trackerSnapshots.id)})`;
		const gapsCte = db()
			.$with("gaps")
			.as(
				db()
					.select({
						point: trackerSnapshots.point,
						delta: deltaSql.as("delta"),
						timestamp: trackerSnapshots.timestamp,
					})
					.from(trackerSnapshots)
					.where(baseFilter),
			);

		const cteFilter = and(
			gte(gapsCte.timestamp, after.toDate()),
			gt(gapsCte.delta, 0),
			lte(gapsCte.delta, outlierCap),
		);

		return allKeyed({
			profile: db().query.trackerSnapshotProfiles.findFirst({
				columns: { name: true },
				where: {
					trackingFor: params.kind,
					trackingId: params.id,
					uid,
				},
			}),
			statistics: Astro.locals.tracing.enterSpan(
				"fetch-game-statistics",
				async () => {
					const [statistics] = await db()
						.with(gapsCte)
						.select({
							gamesTotal: sql<number>`COUNT(*)`,
							minPoints: min(gapsCte.delta),
							maxPoints: max(gapsCte.delta),
							meanPoints: avg(gapsCte.delta),
							medianPoints: sql<number>`MEDIAN(${gapsCte.delta})`,

							latestPoint: sql<number>`(SELECT ${trackerSnapshots.point} FROM ${trackerSnapshots} WHERE ${cteFilter} ORDER BY ${desc(trackerSnapshots.id)} LIMIT 1)`,
							oldestPoint: sql<number>`(SELECT ${trackerSnapshots.point} FROM ${trackerSnapshots} WHERE ${cteFilter} ORDER BY ${asc(trackerSnapshots.id)} LIMIT 1)`,
						})
						.from(gapsCte)
						.where(cteFilter);

					return {
						...mapValues(statistics, (value) => Number(value ?? 0)),
						pointsPerHour:
							(statistics.latestPoint - statistics.oldestPoint) /
							dayjs().diff(after, "hours", true),
					};
				},
			),
			games: Astro.locals.tracing.enterSpan("fetch-game-list", () =>
				db()
					.with(gapsCte)
					.select({
						point: gapsCte.point,
						timestamp: gapsCte.timestamp,
						delta: gapsCte.delta,
					})
					.from(gapsCte)
					.where(gte(gapsCte.timestamp, after.toDate()))
					.orderBy(desc(gapsCte.timestamp)),
			),
		});
	},
);

if (Astro.cache.enabled) Astro.cache.set({ maxAge: 30, swr: 30 });
---

<SheetModal
	{...params.duration === "1h" && {
		"hx-get": `${Astro.url.pathname}${Astro.url.search}`,
		"hx-indicator": "#recent-games-loader",
		"hx-on": [
			import.meta.env.PROD &&
				UMAMI_SITE_ID &&
				profile &&
				`htmx:before:request from:self -> umami.track("recent-games-poll", { player: "${profile.name}", kind: "${params.kind}" })`,
			"htmx:before:request from:self -> if (document.hidden) event.preventDefault()",
		]
			.filter(Boolean)
			.join(";"),
		"hx-trigger": "load delay:60s, visibilitychange from:document",
	}}
>
	<h2 class="text-center text-2xl font-medium">
		<Icon
			class="htmx-indicator mr-1 size-5 align-[-1px]"
			id="recent-games-loader"
			name="svg-spinners--90-ring-with-bg"
		/>

		{
			profile
				? `${profile.name}: Recent Games (${params.duration})`
				: "Player not found"
		}
	</h2>

	<fieldset
		hx-vals:inherited={JSON.stringify(omit(params, ["duration"]))}
		class="tabs mt-4 w-full tabs-sm text-accent"
		role="tablist"
	>
		{
			DURATIONS.map((duration) => (
				<label class="tab h-16 flex-col hover:text-accent max-md:flex-1 md:px-12">
					<input
						hx-get={Astro.url.pathname}
						hx-disable="closest .tabs"
						data-umami-event="tracker-recent-games-duration"
						data-umami-event-duration={duration}
						data-umami-event-kind={params.kind}
						data-umami-event-player={profile?.name}
						name="duration"
						type="radio"
						value={duration}
						checked={duration === params.duration}
					/>
					<IconLoader class="size-5" name="lucide--clock" />
					{duration}
				</label>
			))
		}
	</fieldset>

	<div class="mt-4 flex max-w-4/5 flex-wrap justify-center gap-x-1 gap-y-0.5">
		{
			params.duration !== "1h" && (
				<div class="badge badge-md badge-primary">
					{formatNumber(statistics.gamesTotal / dayjs().diff(after, "hours"))}{" "}
					Games/hour
				</div>
			)
		}
		<div class="badge badge-md badge-accent">
			{statistics.gamesTotal} Games
		</div>
		<div class="badge badge-md badge-info">
			Average:{" "}
			{
				formatNumber(Math.round(statistics.meanPoints), {
					positiveSign: true,
				})
			}
		</div>
		<div class="badge badge-md badge-info">
			Median:{" "}
			{formatNumber(statistics.medianPoints, { positiveSign: true })}
		</div>
		<div class="badge badge-md badge-info">
			Min: {formatNumber(statistics.minPoints, { positiveSign: true })}
		</div>
		<div class="badge badge-md badge-info">
			Max: {formatNumber(statistics.maxPoints, { positiveSign: true })}
		</div>
		<div class="badge badge-md badge-info">
			{formatNumber(statistics.pointsPerHour, { positiveSign: true })}{" "}
			Pts/hour
		</div>
	</div>

	<ul
		class="timeline timeline-vertical mt-2 max-h-[60vh] w-full max-w-120 overflow-y-auto"
	>
		{
			games.map(({ point, timestamp, delta }, idx) => (
				<li>
					{idx > 0 && <hr class="bg-neutral" />}
					<div class="timeline-start font-mono">
						{formatDuration(dayjs(timestamp), dayjs())}
					</div>
					<div class="timeline-end">
						<div class="inline-flex items-center font-semibold">
							{formatNumber(point)}
							<span
								class:list={[
									"ml-1 badge px-1.5 badge-xs",
									delta > outlierCap ? "badge-warning" : "badge-success",
								]}
							>
								{formatNumber(delta, { positiveSign: true })}
							</span>

							{delta > outlierCap && (
								<span
									class="tooltip tooltip-end ml-1 badge badge-xs tooltip-warning badge-warning before:max-w-32"
									data-tip="Likely accumulated while untracked"
								>
									gap
								</span>
							)}
						</div>
					</div>
					{idx < games.length - 1 && <hr class="bg-neutral" />}
				</li>
			))
		}
	</ul>

	{
		statistics.gamesTotal === 0 && (
			<div class="flex items-center justify-center gap-2 py-16">
				<Icon class="size-10" name="lucide--x" />
				<span class="text-lg font-medium">No recent games found</span>
			</div>
		)
	}
</SheetModal>
