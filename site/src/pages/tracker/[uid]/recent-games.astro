---
import { UMAMI_SITE_ID } from "astro:env/server";

import z from "zod";

import dayjs, { formatDuration } from "@bandori-stats/bestdori/date";
import {
	formatNumber,
	mean,
	median,
	omit,
} from "@bandori-stats/bestdori/helpers";
import { db } from "@bandori-stats/database";
import IconLoader from "~/components/icon-loader.astro";
import Icon from "~/components/icon.astro";
import SheetModal from "~/layouts/sheet-modal.astro";

export const partial = true;

const DURATIONS = ["1h", "3h", "6h", "12h", "1d"] as const;

const uid = Astro.params.uid!;
const params = Astro.locals.parseQuery(
	z.object({
		kind: z.enum(["event", "monthly"]),
		id: z.coerce.number(),
		duration: z.enum(DURATIONS),
	}),
);

let after: dayjs.Dayjs;
if (params.duration === "1h") after = dayjs().subtract(1, "hour");
else if (params.duration === "3h") after = dayjs().subtract(3, "hour");
else if (params.duration === "6h") after = dayjs().subtract(6, "hour");
else if (params.duration === "12h") after = dayjs().subtract(12, "hour");
else after = dayjs().subtract(1, "day");

const snapshots = await Astro.locals.tracing.enterSpan(
	"fetch-snapshots",
	async (span) => {
		span.setAttribute("uid", uid);
		span.setAttribute("kind", params.kind);
		span.setAttribute("id", params.id);
		span.setAttribute("duration", params.duration);
		span.setAttribute("after", after.toISOString());

		const rows = await db().query.trackerSnapshots.findMany({
			columns: { name: true, point: true, timestamp: true },
			where: {
				uid,
				trackingFor: params.kind,
				trackingId: params.id,
				timestamp: { gt: after.toDate() },
			},
			orderBy: { id: "desc" },
		});

		if (rows.length > 0) {
			const previous = await db().query.trackerSnapshots.findFirst({
				columns: { name: true, point: true, timestamp: true },
				where: {
					uid,
					trackingFor: params.kind,
					trackingId: params.id,
					timestamp: { lte: after.toDate() },
					point: { ne: rows.at(-1)!.point },
				},
				orderBy: { id: "desc" },
			});

			if (previous) rows.push(previous);
		}

		return rows.filter(
			({ point }, idx, snapshots) => point !== snapshots.at(idx + 1)?.point,
		);
	},
);

const rawPoints = snapshots
	.slice(0, -1)
	.map(({ point }, idx) => point - snapshots[idx + 1].point);
const outlierThreshold = mean(rawPoints) * 3;

const points = rawPoints.filter((point) => point <= outlierThreshold);
const games = snapshots.slice(0, -1).map(({ point, timestamp }, idx) => ({
	point,
	timestamp,
	delta: point - snapshots[idx + 1].point,
}));

const pointsPerHour = (() => {
	if (snapshots.length < 2) return 0;

	const [first, last] = [snapshots[0], snapshots.at(-1)!];
	const pointsGained = first.point - last.point;
	const duration = dayjs().diff(after, "hour");
	return pointsGained / duration;
})();

if (Astro.cache.enabled) Astro.cache.set({ maxAge: 30, swr: 30 });
---

<SheetModal
	{...params.duration === "1h" && {
		"hx-get": `${Astro.url.pathname}${Astro.url.search}`,
		"hx-indicator": "find .recent-games-loader",
		"hx-on":
			import.meta.env.PROD && UMAMI_SITE_ID && snapshots.length > 0
				? `htmx:before:request from:self -> umami.track("recent-games-poll", { player: "${snapshots[0].name}", kind: "${params.kind}" })`
				: undefined,
		"hx-trigger": "load delay:60s",
	}}
>
	<h2 class="text-center text-2xl font-medium">
		<Icon
			class="recent-games-loader htmx-indicator mr-1 size-5 align-middle"
			name="svg-spinners--90-ring-with-bg"
		/>

		{
			snapshots.length > 0
				? `${snapshots[0].name}: Recent Games (${params.duration})`
				: `Recent Games (${params.duration})`
		}
	</h2>

	<fieldset
		hx-vals:inherited={JSON.stringify(omit(params, ["duration"]))}
		class="tabs mt-4 w-full tabs-sm text-accent"
		role="tablist"
	>
		{
			DURATIONS.map((duration) => (
				<label class="tab h-16 flex-col hover:text-accent max-md:flex-1 md:px-12">
					<input
						hx-get={Astro.url.pathname}
						hx-disable="closest .tabs"
						data-umami-event="tracker-recent-games-duration"
						data-umami-event-duration={duration}
						name="duration"
						type="radio"
						value={duration}
						checked={duration === params.duration}
					/>
					<IconLoader class="size-5" name="lucide--clock" />
					{duration}
				</label>
			))
		}
	</fieldset>

	{
		snapshots.length > 0 && (
			<>
				<div class="mt-4 flex max-w-4/5 flex-wrap justify-center gap-x-1 gap-y-0.5">
					{params.duration !== "1h" && (
						<div class="badge badge-md badge-primary">
							{formatNumber(
								(snapshots.length - 1) / dayjs().diff(after, "hours"),
							)}{" "}
							Games/hour
						</div>
					)}

					<div class="badge badge-md badge-accent">
						{snapshots.length - 1} Games
					</div>
					<div class="badge badge-md badge-info">
						Average:{" "}
						{formatNumber(Math.round(mean(points)), { positiveSign: true })}
					</div>
					<div class="badge badge-md badge-info">
						Median: {formatNumber(median(points), { positiveSign: true })}
					</div>
					<div class="badge badge-md badge-info">
						Min: {formatNumber(Math.min(...points), { positiveSign: true })}
					</div>
					<div class="badge badge-md badge-info">
						Max: {formatNumber(Math.max(...points), { positiveSign: true })}
					</div>
					<div class="badge badge-md badge-info">
						{formatNumber(pointsPerHour, { positiveSign: true })} Pts/hour
					</div>
				</div>

				<ul class="timeline timeline-vertical mt-2 max-h-[60vh] w-full max-w-120 overflow-y-auto">
					{games.map(({ point, timestamp, delta }, idx) => (
						<li>
							{idx > 0 && <hr class="bg-neutral" />}
							<div class="timeline-start font-mono">
								{formatDuration(dayjs(timestamp), dayjs())}
							</div>
							<div class="timeline-end">
								<div class="inline-flex items-center font-semibold">
									{formatNumber(point)}
									<span
										class:list={[
											"ml-1 badge px-1.5 badge-xs",
											delta > outlierThreshold
												? "badge-warning"
												: "badge-success",
										]}
									>
										{formatNumber(delta, { positiveSign: true })}
									</span>

									{delta > outlierThreshold && (
										<span
											class="tooltip tooltip-end ml-1 badge badge-xs tooltip-warning badge-warning before:max-w-32"
											data-tip="Likely accumulated while untracked"
										>
											gap
										</span>
									)}
								</div>
							</div>
							{idx < games.length - 1 && <hr class="bg-neutral" />}
						</li>
					))}
				</ul>
			</>
		)
	}

	{
		snapshots.length === 0 && (
			<div class="flex items-center justify-center gap-2 py-16">
				<Icon class="size-10" name="lucide--x" />
				<span class="text-lg font-medium">No recent games found</span>
			</div>
		)
	}
</SheetModal>
