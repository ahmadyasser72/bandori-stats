---
import { UMAMI_SITE_ID } from "astro:env/server";

import z from "zod";

import dayjs, { formatDuration } from "@bandori-stats/bestdori/date";
import {
	capitalize,
	formatNumber,
	mapValues,
	sum,
} from "@bandori-stats/bestdori/helpers";
import { db } from "@bandori-stats/database";
import { GBP, redis } from "@bandori-stats/database/redis";
import { sumStats } from "@bandori-stats/database/schema";
import IconLoader from "~/components/icon-loader.astro";
import Icon from "~/components/icon.astro";
import { getProfileIcon, getTitleImage } from "~/lib/assets";

export const partials = true;

const params = Astro.locals.parseQuery(
	z.object({
		kind: z.enum(["event", "monthly"]),
		poll: z.stringbool().catch(false),
	}),
);

const { data, isPastData, players } = await Astro.locals.tracing.enterSpan(
	"fetch-data",
	async () => {
		const data = await Astro.locals.tracing.enterSpan(
			"fetch-latest-data",
			async (span) => {
				span.setAttribute("kind", params.kind);

				if (params.kind === "event") {
					const event = await db().query.gbpEvents.findFirst({
						orderBy: { eventId: "desc" },
					});
					return { ...event!, name: event?.eventName!, id: event?.eventId! };
				} else {
					const monthly = await db().query.gbpMonthlyRankings.findFirst({
						orderBy: { monthlyRankingId: "desc" },
					});
					return {
						...monthly!,
						name: monthly?.monthlyRankingName!,
						id: monthly?.monthlyRankingId!,
					};
				}
			},
		);

		const isPastData = dayjs().isAfter(data.endAt);

		const key = GBP[params.kind][data.id];
		const top10 = await Astro.locals.tracing.enterSpan(
			"fetch-top-10",
			(span) => {
				span.setAttribute("key", key);

				return redis().mget<number[]>(
					...Array.from({ length: 10 }, (_, idx) => `${key}:${idx + 1}`),
				);
			},
		);

		const players = await Astro.locals.tracing.enterSpan(
			"fetch-snapshots",
			(span) => {
				for (const [idx, uid] of top10.entries())
					span.setAttribute(`t${idx + 1}`, uid);

				return Promise.all(
					top10.map((uid) =>
						db().query.trackerSnapshots.findMany({
							columns: { trackingFor: false, trackingId: false },
							where: {
								trackingFor: params.kind,
								trackingId: data.id,
								uid: uid.toString(),
							},
							limit: 2,
							orderBy: { id: "desc" },
							with: {
								profiles: {
									columns: {
										level: true,
										avatar: true,
										introduction: true,
										band: true,
										titles: true,
									},
									where: {
										trackingFor: params.kind,
										trackingId: data.id,
									},
								},
							},
						}),
					),
				);
			},
		);

		for (const [idx, [current, previous]] of players.entries()) {
			if (!previous) continue;

			if (current.point === previous.point) {
				players[idx] = await Astro.locals.tracing.enterSpan(
					"fetch-same-points",
					async (span) => {
						span.setAttribute("uid", current.uid);
						span.setAttribute("point", current.point);

						return db().query.trackerSnapshots.findMany({
							columns: { trackingFor: false, trackingId: false },
							where: {
								trackingFor: params.kind,
								trackingId: data.id,
								uid: current.uid,
								point: current.point,
							},
							orderBy: { id: "desc" },
							with: {
								profiles: {
									columns: {
										level: true,
										avatar: true,
										introduction: true,
										band: true,
										titles: true,
									},
									where: {
										trackingFor: params.kind,
										trackingId: data.id,
									},
								},
							},
						});
					},
				);
			}
		}

		return {
			data,
			isPastData,
			players: players.map((snapshots) => {
				const [latest, previous] = snapshots;
				const lastPlayed =
					!isPastData && latest.point === previous?.point
						? snapshots.at(-1)!
						: latest;

				return {
					latest,
					previous:
						!isPastData && dayjs().diff(latest.timestamp, "minutes") <= 30
							? previous
							: undefined,
					lastPlayed,
					boatHistory:
						previous &&
						latest.point === previous.point &&
						latest.rank > lastPlayed.rank
							? snapshots.reverse()
							: undefined,

					profile: latest.profiles.at(0),
				};
			}),
		};
	},
);

const getBonusPercentage = (baseStat: number, bonusStat: number) =>
	(Math.ceil((bonusStat / baseStat) * 10000) / 100).toLocaleString("en-US", {
		minimumFractionDigits: 1,
	});

if (Astro.cache.enabled)
	Astro.cache.set(isPastData ? { maxAge: 60 * 60 } : { maxAge: 30, swr: 30 });
---

{
	!params.poll && (
		<>
			<hx-partial hx-target="#tracker-info">
				<div
					hx-get="/tracker/metadata"
					hx-headers="js:{ 'client-timezone': Intl.DateTimeFormat().resolvedOptions().timeZone }"
					hx-swap="outerHTML"
					hx-trigger="intersect once"
					hx-vals={JSON.stringify({ kind: params.kind, id: data.id })}
					class="mt-4 flex flex-col items-center gap-1"
				>
					<div class="flex gap-1">
						<div class="flex flex-col justify-evenly">
							<div class="size-10" />
							<div class="size-10 skeleton" />
						</div>

						<div class="aspect-9/4 w-64 skeleton" />

						<div class="flex flex-col justify-evenly">
							<div class="size-10 skeleton" />
							<div class="size-10 skeleton" />
						</div>
					</div>

					<h2 class="skeleton skeleton-text text-center text-lg font-semibold">
						Loading {params.kind}...
					</h2>

					<div class="flex w-full flex-col gap-1">
						<div class="flex translate-y-1.5 justify-between px-0.5">
							<span class="h-4 w-24 skeleton" />
							<span class="h-4 w-24 skeleton" />
						</div>

						<div class="relative w-full">
							<progress class="progress w-full opacity-50" />

							<div class="absolute center badge badge-sm badge-neutral">~</div>
						</div>
					</div>
				</div>
			</hx-partial>

			<hx-partial hx-swap="after" hx-target="main">
				<div class="toast toast-center">
					<div class="htmx-indicator alert alert-info" id="tracker-list-loader">
						<Icon class="size-6" name="svg-spinners--90-ring-with-bg" />
						<span class="font-medium">Reloading tracker data...</span>
					</div>
				</div>
			</hx-partial>
		</>
	)
}

<div
	{...!isPastData && {
		"hx-get": Astro.url.pathname,
		"hx-browser-indicator": "true",
		"hx-indicator": "#tracker-list-loader",
		"hx-on": [
			import.meta.env.PROD &&
				UMAMI_SITE_ID &&
				`htmx:before:request from:self -> umami.track("tracker-poll", { name: "${data.name}", kind: "${params.kind}" })`,
			"htmx:before:request from:self -> if (document.hidden) event.preventDefault()",
		]
			.filter(Boolean)
			.join(";"),
		"hx-swap": "outerHTML transition:true",
		"hx-trigger": "load delay:60s, visibilitychange from:document",
		"hx-vals": JSON.stringify({ kind: params.kind, poll: true }),
	}}
	class="list mt-4 py-1"
	id="tracker-list"
>
	{
		players.map(({ latest, previous, lastPlayed, boatHistory, profile }) => (
			<div
				class:list={[
					latest.rank <= 3 && "aura not-last:mb-1.5",
					latest.rank === 1 && "aura-holo",
					latest.rank === 2 && "aura-gold",
					latest.rank === 3 && "aura-silver",

					dayjs().diff(lastPlayed.timestamp, "minutes") >= 30 &&
						"opacity-50 transition-opacity hover:opacity-100 focus:opacity-100",
				]}
				style={`view-transition-name: uid-${latest.uid}`}
				tabindex="-1"
			>
				<div
					class:list={[
						"list-row items-center",
						latest.rank <= 3 && "bg-base-100 dark:bg-base-300",
					]}
				>
					<div class="flex flex-col items-center gap-0.5 font-mono">
						<span
							class:list={[
								"badge size-10 px-0",
								latest.rank === 1 && "badge-primary",
								latest.rank === 2 && "badge-accent",
								latest.rank === 3 && "badge-secondary",
								latest.rank > 3 && "badge-ghost",
							]}
						>
							{latest.rank}
						</span>

						{lastPlayed.rank !== latest.rank && (
							<span
								class:list={[
									"badge w-8 px-0 badge-xs font-semibold",
									latest.rank < lastPlayed.rank && "badge-success",
									latest.rank > lastPlayed.rank && "badge-error",
								]}
							>
								{latest.rank < lastPlayed.rank ? "▲" : "▼"}{" "}
								{Math.abs(lastPlayed.rank - latest.rank)}
							</span>
						)}
					</div>

					<div class="flex min-w-0 items-center gap-2 list-col-grow">
						{profile?.avatar && (
							<div class="avatar">
								<div class="size-10 rounded-box">
									<img
										src={getProfileIcon({ profileArt: profile.avatar })}
										alt={latest.name}
										loading="lazy"
									/>
								</div>
							</div>
						)}

						<span class="flex-1 truncate text-lg font-medium text-ellipsis">
							{latest.name}
						</span>

						<button
							data-umami-event="tracker-profile"
							data-umami-event-kind={params.kind}
							data-umami-event-name={data.name}
							data-umami-event-player={latest.name}
							class="btn btn-info btn-sm max-sm:hidden"
							disabled={!profile}
							popovertarget={`profile-${latest.uid}`}
							style={`anchor-name: --anchor-${latest.uid}-profile`}
						>
							<IconLoader name="lucide--id-card" />
							Profile
						</button>
					</div>

					<div class="list-col-wrap grid grid-cols-5 justify-between gap-2 sm:flex">
						<div class="col-span-3 flex flex-col text-sm">
							<span class="inline-flex items-center font-semibold">
								{formatNumber(latest.point)}
								{previous && latest.point !== previous.point && (
									<span class="ml-1 badge px-1.5 badge-xs badge-success">
										{formatNumber(latest.point - previous.point, {
											positiveSign: true,
										})}
									</span>
								)}
							</span>

							{!isPastData && (
								<span>
									played{" "}
									{dayjs().diff(lastPlayed.timestamp, "minutes") < 1
										? "just now"
										: dayjs(lastPlayed.timestamp).fromNow()}
								</span>
							)}

							{!isPastData && boatHistory && (
								<span>
									boated{" "}
									{boatHistory.length === 1 ? (
										<span class="text-error">
											{dayjs(latest.timestamp).fromNow()}
										</span>
									) : (
										<span class="tooltip tooltip-error text-error underline decoration-dotted sm:tooltip-end">
											<div class="tooltip-content">
												<div class="flex flex-col">
													{boatHistory
														.slice(1)
														.map(({ timestamp, rank }, idx) => (
															<div class="flex justify-between gap-2">
																<span>
																	{boatHistory[idx].rank} -> {rank}
																</span>
																<span>
																	{formatDuration(dayjs(timestamp), dayjs())}
																</span>
															</div>
														))}
												</div>
											</div>
											{dayjs(latest.timestamp).fromNow()}
										</span>
									)}
								</span>
							)}
						</div>

						<button
							data-umami-event="tracker-profile"
							data-umami-event-kind={params.kind}
							data-umami-event-name={data.name}
							data-umami-event-player={latest.name}
							class="btn col-span-2 self-center btn-info btn-sm sm:hidden"
							disabled={!profile}
							popovertarget={`profile-${latest.uid}`}
							style={`anchor-name: --anchor-${latest.uid}-profile`}
						>
							<IconLoader name="lucide--id-card" />
							Profile
						</button>

						<div class="col-span-full flex gap-1 sm:justify-end">
							{!isPastData && (
								<button
									hx-get={`/tracker/${latest.uid}/recent-games`}
									hx-vals={JSON.stringify({
										kind: params.kind,
										id: data.id,
										duration:
											dayjs().diff(lastPlayed.timestamp, "minutes") < 60
												? "1h"
												: "12h",
									})}
									data-umami-event="tracker-recent-games"
									data-umami-event-kind={params.kind}
									data-umami-event-name={data.name}
									data-umami-event-player={latest.name}
									class="btn btn-primary btn-xs sm:btn-sm"
								>
									<IconLoader class="max-sm:size-3" name="lucide--gamepad-2" />
									Recent
								</button>
							)}

							<button
								hx-get={`/tracker/${latest.uid}/statistics`}
								hx-swap="after"
								hx-target="main"
								hx-vals={JSON.stringify({
									kind: params.kind,
									id: data.id,
									duration: dayjs().isBefore(data.endAt) ? "1d" : "all",
								})}
								data-umami-event="tracker-statistics"
								data-umami-event-kind={params.kind}
								data-umami-event-name={data.name}
								data-umami-event-player={latest.name}
								class="btn btn-accent btn-xs max-sm:flex-1 sm:btn-sm"
							>
								<IconLoader class="max-sm:size-3" name="lucide--bar-chart-3" />
								Statistics
							</button>

							{!isPastData && (
								<button
									hx-get={`/tracker/${latest.uid}/notify`}
									hx-swap="after"
									hx-target="main"
									hx-vals={JSON.stringify({ kind: params.kind, id: data.id })}
									data-umami-event="tracker-notify"
									data-umami-event-kind={params.kind}
									data-umami-event-name={data.name}
									data-umami-event-player={latest.name}
									class="btn btn-secondary btn-xs max-sm:flex-1 sm:btn-sm"
								>
									<IconLoader class="max-sm:size-3" name="lucide--bell" />
									Notify me
								</button>
							)}
						</div>
					</div>

					{profile && (
						<div
							hx-preserve
							class="dropdown dropdown-end dropdown-top w-75 overflow-visible sm:w-90"
							id={`profile-${latest.uid}`}
							popover
							style={`position-anchor: --anchor-${latest.uid}-profile`}
						>
							<div class="flex flex-col items-center">
								<h3 class="text-center">
									<span class="text-xs">Level {profile.level}</span>
									<br />
									<span class="text-xl font-medium">{latest.name}</span>
								</h3>
								<p class="mt-1">{profile.introduction}</p>
								<div class="mt-1 flex gap-1">
									{profile.titles.map((id) => (
										<img
											class="aspect-23/5 w-32 rounded-2xl"
											src={getTitleImage(id)}
											loading="lazy"
										/>
									))}
								</div>

								<div class="mt-2 flex w-full items-end justify-between text-lg">
									<span class="font-medium">{profile.band.name}</span>
									{profile.band.totalStats ? (
										<span class="tooltip tooltip-end tooltip-info underline decoration-dotted">
											<div class="tooltip-content">
												<div class="flex flex-col">
													{Object.entries(profile.band.totalStats).map(
														([type, value]) => (
															<div class="flex w-full items-center justify-between">
																<span>{capitalize(type)}</span>
																<span class="ml-4 font-mono">
																	{formatNumber(Math.floor(value))}
																</span>
															</div>
														),
													)}
												</div>
											</div>
											{formatNumber(
												Math.floor(sum(Object.values(profile.band.totalStats))),
											)}
										</span>
									) : (
										<span class="text-base-content/67">Hidden</span>
									)}
								</div>
								<div class="flex w-full justify-between">
									{profile.band.members
										.filter((it) => it !== null)
										.map((it, idx) => ({
											...it,
											statBase: mapValues(
												it.stat,
												(value, type) =>
													value -
													it.potentialBonus[type] -
													it.missionBonus[type],
											),
											tooltipAlign:
												(idx < 2 && "tooltip-start") ||
												(idx > 2 && "tooltip-end"),
										}))
										.map(
											({
												id,
												rarity,
												attribute,
												band,
												trained,
												level,
												trainedStatus,
												limitBreakRank,
												skill,
												stat,
												statBase,
												potentialBonus,
												missionBonus,
												tooltipAlign,
											}) => (
												<div
													class:list={[
														"tooltip tooltip-bottom tooltip-info before:w-64",
														tooltipAlign,
													]}
													data-tip={skill}
												>
													<div
														class:list={[
															"tooltip gbp-card tooltip-info",
															tooltipAlign,
														]}
													>
														<span class="tooltip-content w-64">
															<div class="flex flex-col">
																{[
																	[
																		"Power",
																		`${formatNumber(sumStats(stat))} (+${formatNumber(sumStats(potentialBonus) + sumStats(missionBonus))})`,
																	],

																	...Object.keys(stat).map((type) => [
																		capitalize(type),
																		`${formatNumber(stat[type])} (+${formatNumber(potentialBonus[type] + missionBonus[type])})`,
																	]),

																	[
																		"Potentials",
																		Object.keys(stat)
																			.map(
																				(type) =>
																					`+${getBonusPercentage(statBase[type], potentialBonus[type])}%`,
																			)
																			.join(" "),
																	],
																	[
																		"Missions",
																		Object.keys(stat)
																			.map(
																				(type) =>
																					`+${getBonusPercentage(statBase[type], missionBonus[type])}%`,
																			)
																			.join(" "),
																	],
																].map(([key, value]) => (
																	<div class="flex w-full items-center justify-between">
																		<span>{key}</span>
																		<span class="ml-4 font-mono">{value}</span>
																	</div>
																))}
															</div>
														</span>

														<img
															class="gbp-card-icon"
															src={getProfileIcon({
																profileArt: { id, trained },
															})}
															alt={`card ${id}`}
															loading="lazy"
														/>
														{rarity > 1 && (
															<img
																class="gbp-card-frame"
																src={`/assets/card-frame/${rarity}.webp`}
																loading="lazy"
															/>
														)}

														<img
															class="gbp-card-band"
															src={`/assets/bands/${band}.svg`}
															loading="lazy"
														/>
														<img
															class="gbp-card-attribute"
															src={`/assets/attributes/${attribute}.svg`}
															loading="lazy"
														/>

														<div class="gbp-card-stars">
															{Array.from({ length: rarity }, () => (
																<img
																	src={`/assets/card-rarity/${trainedStatus ? "trained" : "normal"}.webp`}
																	loading="lazy"
																/>
															))}
														</div>
														{limitBreakRank > 0 && (
															<div class="gbp-card-limit-break">
																<img
																	src="/assets/card-limit-break/overlay.svg"
																	loading="lazy"
																/>
																<span>{limitBreakRank}</span>
															</div>
														)}

														<div class="gbp-card-level">{level}</div>
													</div>
												</div>
											),
										)}
								</div>
							</div>
						</div>
					)}
				</div>
			</div>
		))
	}
</div>
