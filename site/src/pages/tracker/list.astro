---
import { UMAMI_SITE_ID } from "astro:env/server";

import z from "zod";

import dayjs, { formatDuration } from "@bandori-stats/bestdori/date";
import { formatNumber, stripBB } from "@bandori-stats/bestdori/helpers";
import { db } from "@bandori-stats/database";
import { GBP, redis } from "@bandori-stats/database/redis";
import {
	getTrackingMetadata,
	getTrackingReference,
	TrackingTarget,
} from "@bandori-stats/database/tracker";
import GbpCard from "~/components/gbp-card.astro";
import IconLoader from "~/components/icon-loader.astro";
import Icon from "~/components/icon.astro";
import ProfileDropdown from "./_profile-dropdown.astro";

export const partials = true;

const { poll, ...params } = Astro.locals.parseQuery(
	z.object({ ...TrackingTarget.shape, poll: z.stringbool().catch(false) }),
);

const metadata = await Astro.locals.tracing.enterSpan(
	"fetch-metadata",
	async (span) => {
		span.setAttribute("kind", params.kind);
		span.setAttribute("id", params.id);

		return getTrackingMetadata(params);
	},
);
if (!metadata) return new Response(null, { status: 404 });

const isPastData = dayjs().isAfter(metadata.endAt);

const players = await Astro.locals.tracing.enterSpan("fetch-data", async () => {
	const top10 = await Astro.locals.tracing.enterSpan(
		"fetch-t10",
		async (span) => {
			const key = GBP.fromMetadata(params, "leaderboard");
			span.setAttribute("key", key);

			return redis()
				.zrange<number[]>(key, 0, 9, { rev: true })
				.then((uids) => uids.map((uid) => uid.toString()));
		},
	);
	if (top10.length === 0) return [];

	const trackingReference = getTrackingReference(params);
	const getSnapshots = (uid: string) =>
		db().query.trackerSnapshots.findMany({
			columns: { trackingFor: false, trackingId: false },
			where: { ...trackingReference, uid },
			limit: isPastData ? 1 : 2,
			orderBy: { id: "desc" },
		});
	const getProfile = (uid: string) =>
		db().query.trackerSnapshotProfiles.findFirst({
			where: { ...trackingReference, uid },
		});

	const players = await Astro.locals.tracing.enterSpan(
		"fetch-players",
		async (span) => {
			for (const [idx, uid] of top10.entries())
				span.setAttribute(`t${idx + 1}`, uid);

			const rows = await db().batch([
				getSnapshots(top10[0]),
				getProfile(top10[0]),
				...top10
					.slice(1)
					.flatMap((uid) => [getSnapshots(uid), getProfile(uid)]),
			]);

			return Promise.all(
				top10.map(async (_, idx) => {
					let snapshots = rows[2 * idx] as Awaited<
						ReturnType<typeof getSnapshots>
					>;

					const [current, previous] = snapshots;
					if (previous && current.point === previous.point) {
						snapshots = await db().query.trackerSnapshots.findMany({
							columns: { trackingFor: false, trackingId: false },
							where: {
								...trackingReference,
								uid: current.uid,
								point: current.point,
							},
							orderBy: { id: "desc" },
						});
					}

					return {
						snapshots,
						profile: rows[2 * idx + 1] as Awaited<
							ReturnType<typeof getProfile>
						>,
					};
				}),
			);
		},
	);

	return players.map(({ snapshots, profile }) => {
		const [latest, previous] = snapshots;
		if (isPastData) return { latest, profile };

		const lastPlayed =
			latest.point === previous?.point ? snapshots.at(-1)! : latest;
		return {
			latest,
			profile,
			previous:
				dayjs().diff(latest.timestamp, "minutes") <= 30 ? previous : undefined,
			lastPlayed,
			boatHistory:
				previous &&
				latest.point === previous.point &&
				latest.rank > lastPlayed.rank
					? snapshots.reverse()
					: undefined,
		};
	});
});

Astro.response.headers.set(
	"hx-replace-url",
	`/tracker?id=${params.id}&tab=${params.kind}`,
);

if (Astro.cache.enabled)
	Astro.cache.set(isPastData ? { maxAge: 60 * 60 } : { maxAge: 30, swr: 30 });
---

{
	!poll && (
		<>
			<hx-partial hx-target="#tracker-info">
				<div
					hx-get="/tracker/metadata"
					hx-headers="js:{ 'client-timezone': Intl.DateTimeFormat().resolvedOptions().timeZone }"
					hx-swap="outerHTML"
					hx-trigger="intersect once"
					hx-vals={JSON.stringify(params)}
					class="mt-4 flex flex-col items-center gap-1"
				>
					<div class="flex gap-1">
						<div class="flex flex-col justify-evenly">
							<div class="size-10 skeleton" />
							<div class="size-10 skeleton" />
						</div>

						<div class="aspect-9/4 w-64 skeleton" />

						<div class="flex flex-col justify-evenly">
							<div class="size-10 skeleton" />
							<div class="size-10 skeleton" />
						</div>
					</div>

					<h2 class="skeleton skeleton-text text-center text-lg font-semibold">
						Loading {params.kind}...
					</h2>

					<div class="flex w-full flex-col gap-1">
						<div class="flex translate-y-1.5 justify-between px-0.5">
							<span class="h-4 w-24 skeleton" />
							<span class="h-4 w-24 skeleton" />
						</div>

						<div class="relative w-full">
							<progress class="progress w-full opacity-50" />

							<div class="absolute center badge badge-sm badge-neutral">~</div>
						</div>
					</div>
				</div>
			</hx-partial>

			<hx-partial hx-swap="after" hx-target="main">
				<div class="toast toast-center">
					<div class="htmx-indicator alert alert-info" id="tracker-list-loader">
						<Icon class="size-6" name="svg-spinners--90-ring-with-bg" />
						<span class="font-medium">Reloading tracker data...</span>
					</div>
				</div>
			</hx-partial>
		</>
	)
}

<div
	{...!isPastData && {
		"hx-get": Astro.url.pathname,
		"hx-browser-indicator": "true",
		"hx-indicator": "#tracker-list-loader",
		"hx-on": [
			import.meta.env.PROD &&
				UMAMI_SITE_ID &&
				`htmx:before:request from:self -> umami.track("tracker-poll", { name: "${metadata.name}", kind: "${params.kind}" })`,
			"htmx:config:request from:self -> if (document.hidden) event.preventDefault()",
		]
			.filter(Boolean)
			.join(";"),
		"hx-swap": "outerMorph transition:true",
		"hx-trigger": "every 60s, visibilitychange from:document",
		"hx-vals": JSON.stringify({ ...params, poll: true }),
	}}
	class="list mt-4 py-1"
	id="tracker-list"
>
	{
		players.length === 0 && (
			<div class="list-row items-center">
				<div class="flex items-center justify-center gap-2 list-col-grow">
					<Icon class="size-10" name="lucide--x" />
					<span class="text-lg font-medium">No data at the moment</span>
				</div>
			</div>
		)
	}

	{
		players.map(({ latest, previous, lastPlayed, boatHistory, profile }) => (
			<div
				class:list={[
					latest.rank <= 3 && "aura not-last:mb-1.5",
					latest.rank === 1 && "aura-holo",
					latest.rank === 2 && "aura-gold",
					latest.rank === 3 && "aura-silver",

					lastPlayed &&
						dayjs().diff(lastPlayed.timestamp, "minutes") >= 30 &&
						"opacity-50 transition-opacity hover:opacity-100 focus:opacity-100",
				]}
				style={`view-transition-name: uid-${latest.uid}`}
				tabindex="-1"
			>
				<div
					class:list={[
						"list-row items-center",
						latest.rank <= 3 && "bg-base-100 dark:bg-base-300",
					]}
				>
					<div class="flex flex-col items-center gap-0.5 font-mono">
						<span
							class:list={[
								"badge size-10 px-0",
								latest.rank === 1 && "badge-primary",
								latest.rank === 2 && "badge-accent",
								latest.rank === 3 && "badge-secondary",
								latest.rank > 3 && "badge-ghost",
							]}
						>
							{latest.rank}
						</span>

						{lastPlayed && lastPlayed.rank !== latest.rank && (
							<span
								class:list={[
									"badge w-8 px-0 badge-xs font-semibold",
									latest.rank < lastPlayed.rank && "badge-success",
									latest.rank > lastPlayed.rank && "badge-error",
								]}
							>
								{latest.rank < lastPlayed.rank ? "▲" : "▼"}{" "}
								{Math.abs(lastPlayed.rank - latest.rank)}
							</span>
						)}
					</div>

					<div class="flex min-w-0 items-center gap-2 list-col-grow">
						{profile?.avatar && (
							<GbpCard class="scale-75" member={profile.avatar} />
						)}

						<span
							class="flex-1 truncate text-lg font-medium text-ellipsis"
							data-bb={latest.name}
						>
							{stripBB(latest.name)}
						</span>

						<button
							data-umami-event="tracker-profile"
							data-umami-event-kind={params.kind}
							data-umami-event-name={metadata.name}
							data-umami-event-player={stripBB(latest.name)}
							class="btn btn-info btn-sm max-sm:hidden"
							disabled={!profile}
							popovertarget={`profile-${latest.uid}`}
							style={`anchor-name: --anchor-${latest.uid}-profile`}
						>
							<IconLoader name="lucide--id-card" />
							Profile
						</button>
					</div>

					<div class="list-col-wrap grid grid-cols-5 justify-between gap-2 sm:flex">
						<div class="col-span-3 flex flex-col text-sm">
							<span class="inline-flex items-center font-semibold">
								{formatNumber(latest.point)}
								{previous && latest.point !== previous.point && (
									<span class="ml-1 badge px-1.5 badge-xs badge-success">
										{formatNumber(latest.point - previous.point, {
											positiveSign: true,
										})}
									</span>
								)}
							</span>

							{lastPlayed && (
								<span>
									played {formatDuration({ from: lastPlayed.timestamp })}
								</span>
							)}

							{boatHistory && (
								<span>
									boated{" "}
									{boatHistory.length === 1 ? (
										<span class="text-error">
											{formatDuration({ from: latest.timestamp })}
										</span>
									) : (
										<span class="tooltip tooltip-error text-error underline decoration-dotted sm:tooltip-end">
											<div class="tooltip-content">
												<div class="flex flex-col">
													{boatHistory
														.slice(1)
														.map(({ timestamp, rank }, idx) => (
															<div class="flex justify-between gap-2">
																<span>
																	{boatHistory[idx].rank} -> {rank}
																</span>
																<span>
																	{formatDuration({ from: timestamp })}
																</span>
															</div>
														))}
												</div>
											</div>
											{formatDuration({ from: latest.timestamp })}
										</span>
									)}
								</span>
							)}
						</div>

						<button
							data-umami-event="tracker-profile"
							data-umami-event-kind={params.kind}
							data-umami-event-name={metadata.name}
							data-umami-event-player={stripBB(latest.name)}
							class="btn col-span-2 self-center btn-info btn-sm sm:hidden"
							disabled={!profile}
							popovertarget={`profile-${latest.uid}`}
							style={`anchor-name: --anchor-${latest.uid}-profile`}
						>
							<IconLoader name="lucide--id-card" />
							Profile
						</button>

						<div class="col-span-full flex gap-1 sm:justify-end">
							<button
								hx-get={`/tracker/${latest.uid}/games`}
								hx-swap="after"
								hx-target="main"
								hx-vals={JSON.stringify({
									...params,
									duration: lastPlayed
										? dayjs().diff(lastPlayed.timestamp, "minutes") < 60
											? "1h"
											: "12h"
										: [
												dayjs(metadata.endAt).subtract(1, "day"),
												dayjs(metadata.endAt),
											]
												.map((date) => date.format("YYYY-MM-DD"))
												.join(":"),
								})}
								data-umami-event="tracker-games"
								data-umami-event-kind={params.kind}
								data-umami-event-name={metadata.name}
								data-umami-event-player={stripBB(latest.name)}
								class="btn btn-primary btn-xs sm:btn-sm"
							>
								<IconLoader class="max-sm:size-3" name="lucide--gamepad-2" />
								Games
							</button>

							<button
								hx-get={`/tracker/${latest.uid}/statistics`}
								hx-swap="after"
								hx-target="main"
								hx-vals={JSON.stringify({
									...params,
									duration: dayjs().isBefore(metadata.endAt) ? "1d" : "all",
								})}
								data-umami-event="tracker-statistics"
								data-umami-event-kind={params.kind}
								data-umami-event-name={metadata.name}
								data-umami-event-player={stripBB(latest.name)}
								class="btn btn-accent btn-xs max-sm:flex-1 sm:btn-sm"
							>
								<IconLoader class="max-sm:size-3" name="lucide--bar-chart-3" />
								Statistics
							</button>

							{!isPastData && (
								<button
									hx-get={`/tracker/${latest.uid}/notify`}
									hx-swap="after"
									hx-target="main"
									hx-vals={JSON.stringify(params)}
									data-umami-event="tracker-notify"
									data-umami-event-kind={params.kind}
									data-umami-event-name={metadata.name}
									data-umami-event-player={stripBB(latest.name)}
									class="btn btn-secondary btn-xs max-sm:flex-1 sm:btn-sm"
								>
									<IconLoader class="max-sm:size-3" name="lucide--bell" />
									Notify me
								</button>
							)}
						</div>
					</div>

					{profile && <ProfileDropdown {metadata} {profile} />}
				</div>
			</div>
		))
	}
</div>
