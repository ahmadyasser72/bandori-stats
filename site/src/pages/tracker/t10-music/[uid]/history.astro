---
import { allKeyed } from "es-toolkit";

import dayjs, { formatDuration } from "@bandori-stats/bestdori/date";
import { formatNumber, stripBB } from "@bandori-stats/bestdori/helpers";
import { db } from "@bandori-stats/database";
import {
	getTrackingMetadata,
	TrackingTarget,
} from "@bandori-stats/database/tracker";
import Icon from "~/components/icon.astro";
import SheetModal from "~/layouts/sheet-modal.astro";
import { IdSchema } from "~/lib/schema";

export const partial = true;

const uid = Astro.params.uid!;
const params = Astro.locals.parseQuery(TrackingTarget);
if (params.kind !== "event") return new Response(null, { status: 404 });

const songId = IdSchema.parse(Astro.params.song);
const { metadata, profile } = await Astro.locals.tracing.enterSpan(
	"fetch-metadata",
	async (span) => {
		span.setAttribute("uid", uid);
		span.setAttribute("kind", params.kind);
		span.setAttribute("id", params.id);

		return allKeyed({
			profile: db().query.trackerSnapshotProfiles.findFirst({
				columns: { name: true },
				where: { trackingFor: "music", trackingId: songId, uid },
			}),
			metadata: getTrackingMetadata(params),
		});
	},
);
if (!metadata || metadata.kind !== "event")
	return new Response(null, { status: 404 });

const song = metadata.musics.find(({ id }) => id === songId);
if (!song) return new Response(null, { status: 404 });

const history = await Astro.locals.tracing.enterSpan("fetch-history", () =>
	db()
		.query.trackerSnapshots.findMany({
			columns: { id: false, trackingFor: false, trackingId: false, uid: false },
			where: { trackingFor: "music", trackingId: songId, uid },
			orderBy: { id: "desc" },
		})
		.then((snapshots) =>
			snapshots.map((value, idx) => ({
				value,
				previous: snapshots.at(idx + 1),
			})),
		),
);

const isPastData = dayjs().isAfter(metadata.endAt);

if (Astro.cache.enabled)
	Astro.cache.set(isPastData ? { maxAge: 60 * 60 } : { maxAge: 30, swr: 30 });
---

<SheetModal>
	<h2 class="text-center text-2xl font-medium">
		{
			profile ? (
				<>
					<span data-bb={profile.name}>{stripBB(profile.name)}</span> &mdash;
					History
				</>
			) : (
				"Player not found"
			)
		}
	</h2>
	<span class="text-center font-mono text-sm text-base-content/67">
		({song.title})
	</span>

	<ul
		class="timeline timeline-vertical mt-2 max-h-[60vh] w-full max-w-120 overflow-y-auto"
	>
		{
			history.map(
				({ value: { point, rank, timestamp, name }, previous }, idx) => (
					<li>
						{idx > 0 && <hr class="bg-neutral" />}
						<div class="timeline-start flex flex-col items-end font-mono">
							<span class="text-sm">{formatDuration(timestamp)}</span>
							<span class="text-xs">
								{dayjs
									.tz(timestamp, Astro.locals.clientTimezone)
									.format("MMM DD, hh:mm A")}
							</span>
						</div>
						<div class="timeline-end">
							<div class="flex items-center gap-2">
								<div class="flex flex-col items-center gap-0.5 font-mono">
									<span
										class:list={[
											"badge size-10 px-0",
											rank <= 3 ? "badge-secondary" : "badge-ghost",
										]}
									>
										{rank}
									</span>

									{previous && previous.rank !== rank && (
										<span
											class:list={[
												"badge w-8 px-0 badge-xs font-semibold",
												rank < previous.rank && "badge-success",
												rank > previous.rank && "badge-error",
											]}
										>
											{rank < previous.rank ? "▲" : "▼"}{" "}
											{Math.abs(previous.rank - rank)}
										</span>
									)}
								</div>

								<div class="flex min-w-0 flex-col">
									<span
										class="truncate text-sm font-medium text-ellipsis"
										data-bb={name}
									>
										{stripBB(name)}
									</span>

									<div class="inline-flex items-center font-semibold">
										{formatNumber(point)}
										{previous && point > previous.point && (
											<span class="ml-1 badge px-1.5 badge-xs badge-success">
												+{formatNumber(point - previous.point)}
											</span>
										)}
									</div>
								</div>
							</div>
						</div>
						{idx < history.length - 1 && <hr class="bg-neutral" />}
					</li>
				),
			)
		}
	</ul>

	{
		history.length === 0 && (
			<div class="flex items-center justify-center gap-2 py-16">
				<Icon class="size-10" name="lucide--x" />
				<span class="text-lg font-medium">No history found</span>
			</div>
		)
	}
</SheetModal>
