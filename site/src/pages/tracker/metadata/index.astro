---
import { capitalize, pick } from "es-toolkit";
import z from "zod";

import dayjs, { formatDuration } from "@bandori-stats/bestdori/date";
import type { GbpEventMusic } from "@bandori-stats/database/schema";
import {
	getTrackingMetadata,
	TrackingTarget,
} from "@bandori-stats/database/tracker";
import IconLoader from "~/components/icon-loader.astro";
import Icon from "~/components/icon.astro";
import { getSongAlbumCover, getTrackerLogo } from "~/lib/assets";
import { IdSchema } from "~/lib/schema";
import { DisplaySchema } from "../list";
import { DiscordWebhook } from "./_discord-webhook";

const params = Astro.locals.parseQuery(
	z.object({ ...TrackingTarget.shape, display: DisplaySchema.default("t10") }),
);

const metadata = await Astro.locals.tracing.enterSpan(
	"fetch-metadata",
	async (span) => {
		span.setAttribute("kind", params.kind);
		span.setAttribute("id", params.id);

		return getTrackingMetadata(params);
	},
);
if (!metadata) return new Response(null, { status: 404 });

let song: GbpEventMusic | undefined = undefined;
const [songDisplay, songIdRaw] = params.display.split("-");
const songId = IdSchema.catch(0).parse(songIdRaw);
if (songId !== 0 && metadata.kind === "event")
	song = metadata.musics.find(({ id }) => id === songId);

interface DisplayChoice {
	label: string;
	image?: { kind: "logo" | "music"; url: string };
	items: { value: string; label: string }[];
}

const displayChoices = [] as DisplayChoice[];
if (metadata.kind === "event" && metadata.musics.length > 0) {
	displayChoices.push(
		...(metadata.type === "medley"
			? ([
					{
						label: "Medley Ranking",
						items: [
							{ value: "t10-medley", label: "T10" },
							{ value: "cutoffs-medley", label: "Cutoffs" },
						],
					},
				] satisfies typeof displayChoices)
			: metadata.musics.map(({ id, title }) => ({
					label: title,
					image: { kind: "music" as const, url: getSongAlbumCover({ id }) },
					items: [
						{ value: `t10-${id}`, label: "T10" },
						{ value: `cutoffs-${id}`, label: "Cutoffs" },
					],
				}))),
	);
}

const { clientTimezone } = Astro.locals;
const now = dayjs().tz(clientTimezone);

const isNotStarted = now.isBefore(metadata.startAt);
const isActive = now.isBefore(metadata.endAt);
const progress = (() => {
	if (isNotStarted) return 0;
	else if (!isActive) return 100;
	else
		return (
			(now.diff(metadata.startAt) /
				dayjs(metadata.endAt).diff(metadata.startAt)) *
			100
		);
})();

if (Astro.cache.enabled)
	Astro.cache.set(isActive ? { maxAge: 30, swr: 30 } : { maxAge: 60 * 60 });
---

<div
	{...isActive && {
		"hx-get": `${Astro.url.pathname}${Astro.url.search}&poll=true`,
		"hx-indicator": "#metadata-loader",
		"hx-on":
			"htmx:config:request from:self -> if (document.hidden) event.preventDefault()",
		"hx-swap": "outerMorph",
		"hx-trigger": "every 60s, visibilitychange from:document",
	}}
	class="mt-4 flex flex-col items-center gap-1"
>
	<img
		class={song ? "aspect-square size-48" : "aspect-9/4 w-64"}
		src={song ? getSongAlbumCover(song) : getTrackerLogo(params)}
		alt={`${metadata.assetBundleName} logo`}
	/>

	<h2 class="text-center text-lg font-semibold">
		<Icon
			class="htmx-indicator mr-1 align-[-2px]"
			id="metadata-loader"
			name="svg-spinners--90-ring-with-bg"
		/>

		{metadata.name}
	</h2>

	<span class="-mt-1 text-sm"
		>{
			song
				? `${song.title} — ${capitalize(songDisplay)}`
				: `${capitalize(metadata.kind)} Ranking — ${capitalize(params.display)}`
		}</span
	>

	<div class="flex w-full flex-col">
		<div
			class="flex translate-y-1.5 justify-between px-0.5 text-sm font-medium"
		>
			<span
				{...isActive && {
					class:
						"tooltip tooltip-start tooltip-primary underline decoration-dotted",
					"data-tip": formatDuration(metadata.startAt),
				}}
			>
				{dayjs.tz(metadata.startAt, clientTimezone).format("YYYY-MM-DD, HH:mm")}
			</span>
			<span
				{...isActive && {
					class:
						"tooltip tooltip-end tooltip-primary underline decoration-dotted",
					"data-tip": formatDuration(metadata.endAt),
				}}
			>
				{dayjs.tz(metadata.endAt, clientTimezone).format("YYYY-MM-DD, HH:mm")}
			</span>
		</div>

		<div class="relative w-full">
			<progress
				class="progress w-full progress-primary"
				value={progress}
				max="100"></progress>

			<div class="absolute center badge badge-sm badge-primary">
				{progress.toFixed(1)}%
			</div>
		</div>
	</div>

	<div class="mt-2 flex w-full justify-between gap-2 max-sm:flex-col">
		<div class="join" style="anchor-name: --anchor-tracker-actions">
			{
				isActive && (
					<>
						<button
							data-umami-event="tracker-discord-webhook"
							data-umami-event-kind={params.kind}
							data-umami-event-name={metadata.name}
							class="btn join-item flex-1 btn-secondary btn-sm"
							popovertarget="tracker-discord-webhook"
						>
							<Icon name="lucide--megaphone" />
							Webhook
						</button>
						<div
							hx-morph-skip-children
							class="dropdown dropdown-start w-84 sm:w-md"
							id="tracker-discord-webhook"
							popover
							style="position-anchor: --anchor-tracker-actions"
						>
							<DiscordWebhook
								client:visible
								target={pick(metadata, ["kind", "id"])}
							/>
						</div>
					</>
				)
			}

			<button
				hx-get="/tracker/metadata/info"
				hx-swap="after"
				hx-target="main"
				hx-vals={JSON.stringify(params)}
				data-umami-event="tracker-metadata-info"
				data-umami-event-kind={params.kind}
				data-umami-event-name={metadata.name}
				class="btn join-item flex-1 btn-secondary btn-sm"
			>
				<IconLoader name="lucide--tags" />
				Info
			</button>
		</div>

		<button
			class="btn w-full btn-secondary btn-sm sm:w-max"
			popovertarget="metadata-display-menu"
			style="anchor-name: --anchor-metadata-display-menu"
		>
			<IconLoader name="lucide--list" />
			Display
		</button>
		<div
			class="dropdown dropdown-end"
			id="metadata-display-menu"
			popover
			style="position-anchor: --anchor-metadata-display-menu"
		>
			<ul
				hx-browser-indicator:inherited="true"
				hx-swap:inherited="outerHTML transition:true"
				hx-target:inherited="main"
				hx-vals:inherited={JSON.stringify({ tab: params.kind, id: params.id })}
				class="menu menu-vertical menu-paged w-64"
			>
				<img
					class="mx-auto my-1 aspect-9/4 h-24"
					src={getTrackerLogo(params)}
					loading="lazy"
				/>

				{
					["t10", "cutoffs"].map((value) => (
						<li>
							<button
								hx-get="/tracker"
								hx-vals:append={JSON.stringify({ display: value })}
								class:list={[value === params.display && "menu-active"]}
							>
								<Icon
									class="htmx-indicator"
									name="svg-spinners--90-ring-with-bg"
								/>
								{capitalize(params.kind)} Ranking &mdash; {capitalize(value)}
							</button>
						</li>
					))
				}

				{
					displayChoices.map(({ label, items, image }) => (
						<li>
							<details>
								<summary
									class:list={[
										items.find(({ value }) => value === params.display) &&
											"menu-active",
									]}
								>
									{image && image.kind === "music" && (
										<img
											class="aspect-square size-10"
											src={image.url}
											loading="lazy"
										/>
									)}
									{label}
								</summary>
								<ul>
									{image && (
										<img
											class="mx-auto my-1 aspect-square h-32"
											src={image.url}
											loading="lazy"
										/>
									)}

									{items.map((item) => (
										<li>
											<button
												hx-get="/tracker"
												hx-vals:append={JSON.stringify({ display: item.value })}
												class:list={[
													item.value === params.display && "menu-active",
												]}
											>
												<Icon
													class="htmx-indicator"
													name="svg-spinners--90-ring-with-bg"
												/>
												{label} &mdash; {item.label}
											</button>
										</li>
									))}
								</ul>
							</details>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</div>
