---
import { allKeyed } from "es-toolkit";
import z from "zod";

import dayjs, { formatDuration } from "@bandori-stats/bestdori/date";
import { formatNumber, stripBB } from "@bandori-stats/bestdori/helpers";
import { db } from "@bandori-stats/database";
import {
	getTrackingMetadata,
	getTrackingReference,
	TrackingTarget,
} from "@bandori-stats/database/tracker";
import Icon from "~/components/icon.astro";
import SheetModal from "~/layouts/sheet-modal.astro";

export const partial = true;

const uid = Astro.params.uid!;
const params = Astro.locals.parseQuery(z.object({ ...TrackingTarget.shape }));

const { metadata, profile } = await Astro.locals.tracing.enterSpan(
	"fetch-metadata",
	async (span) => {
		span.setAttribute("uid", uid);
		span.setAttribute("kind", params.kind);
		span.setAttribute("id", params.id);

		return allKeyed({
			profile: db().query.trackerSnapshotProfiles.findFirst({
				columns: { name: true },
				where: { ...getTrackingReference(params), uid },
			}),
			metadata: getTrackingMetadata(params),
		});
	},
);

if (!metadata) return new Response(null, { status: 404 });

const sessions = await Astro.locals.tracing.enterSpan(
	"fetch-sessions",
	(span) => {
		span.setAttribute("uid", uid);
		span.setAttribute("kind", params.kind);
		span.setAttribute("id", params.id);

		return db().query.trackerSessions.findMany({
			columns: {
				games: true,
				points: true,
				lastPlayed: true,
				startAt: true,
				endAt: true,
			},
			where: { ...getTrackingReference(params), uid },
			orderBy: { startAt: "desc" },
		});
	},
);

const isPastData = dayjs().isAfter(metadata.endAt);

if (Astro.cache.enabled)
	Astro.cache.set(isPastData ? { maxAge: 60 * 60 } : { maxAge: 30, swr: 30 });
---

<SheetModal>
	<h2 class="text-center text-2xl font-medium">
		{
			profile ? (
				<>
					<span data-bb={profile.name}>{stripBB(profile.name)}</span> &mdash;
					Sessions
				</>
			) : (
				"Player not found"
			)
		}
	</h2>

	<ul
		class="timeline timeline-vertical mt-4 max-h-[60vh] w-full max-w-120 overflow-y-auto"
	>
		{
			sessions.map(({ games, points, lastPlayed, startAt, endAt }, idx) => (
				<>
					{idx > 0 && (
						<li>
							<hr class="bg-neutral" />
							<div class="timeline-start font-mono text-sm">
								{formatDuration(endAt, sessions[idx - 1].startAt, true)}{" "}
								later...
							</div>
							<hr class="bg-neutral" />
						</li>
					)}

					<li>
						{idx > 0 && <hr class="bg-neutral" />}
						<div class="timeline-start flex flex-col items-end font-mono">
							{games > 1 ? (
								<>
									<span class="text-xs">
										To:{" "}
										{dayjs
											.tz(endAt, Astro.locals.clientTimezone)
											.format("MMM DD, hh:mm A")}
									</span>
									<span class="text-xs">
										From:{" "}
										{dayjs
											.tz(startAt, Astro.locals.clientTimezone)
											.format("MMM DD, hh:mm A")}
									</span>
								</>
							) : (
								<span class="text-xs">
									{dayjs
										.tz(startAt, Astro.locals.clientTimezone)
										.format("MMM DD, hh:mm A")}
								</span>
							)}
						</div>
						<div class="timeline-end">
							<div class="inline-flex flex-col">
								<div class="inline-flex items-center font-semibold">
									{formatNumber(lastPlayed.point)}
									{points > 0 && (
										<span class="ml-1 badge px-1.5 badge-xs badge-success">
											+{formatNumber(points)}
										</span>
									)}
								</div>
								{points > 0 && (
									<span class="text-xs text-base-content/67">
										{games === 1
											? "Played once"
											: `Played ${games} games (${formatDuration(endAt, startAt, true)})`}
									</span>
								)}
							</div>
						</div>
						<hr class="bg-neutral" />
					</li>
				</>
			))
		}
	</ul>

	{
		sessions.length === 0 && (
			<div class="flex items-center justify-center gap-2 py-16">
				<Icon class="size-10" name="lucide--x" />
				<span class="text-lg font-medium">No sessions found</span>
			</div>
		)
	}
</SheetModal>
