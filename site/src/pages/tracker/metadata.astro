---
import { pick } from "es-toolkit";
import z from "zod";

import { GBP_TIMEZONE } from "@bandori-stats/bestdori/constants";
import dayjs, { formatDuration } from "@bandori-stats/bestdori/date";
import { getTrackingMetadata } from "@bandori-stats/database/tracker";
import IconLoader from "~/components/icon-loader.astro";
import Icon from "~/components/icon.astro";
import {
	getTrackerBackground,
	getTrackerBgm,
	getTrackerLogo,
} from "~/lib/assets";
import { DiscordWebhook } from "./_discord-webhook";

const params = Astro.locals.parseQuery(
	z.object({
		kind: z.enum(["event", "monthly"]),
		id: z.coerce.number(),
	}),
);

const data = await Astro.locals.tracing.enterSpan(
	"fetch-data",
	async (span) => {
		span.setAttribute("kind", params.kind);
		span.setAttribute("id", params.id);

		return getTrackingMetadata(params);
	},
);
if (!data) return new Response(null, { status: 404 });

const clientTimezone =
	Astro.request.headers.get("client-timezone") ?? GBP_TIMEZONE;
Astro.response.headers.append("vary", "client-timezone");
const now = dayjs().tz(clientTimezone);

const isNotStarted = now.isBefore(data.startAt);
const isPastData = now.isAfter(data.endAt);
const progress = (() => {
	if (isNotStarted) return 0;
	else if (isPastData) return 100;
	else
		return (
			(now.diff(data.startAt) / dayjs(data.endAt).diff(data.startAt)) * 100
		);
})();

if (Astro.cache.enabled)
	Astro.cache.set(isPastData ? { maxAge: 60 * 60 } : { maxAge: 30, swr: 30 });
---

<div
	{...!isPastData && {
		"hx-get": `${Astro.url.pathname}${Astro.url.search}`,
		"hx-headers": JSON.stringify({ "client-timezone": clientTimezone }),
		"hx-indicator": "#metadata-loader",
		"hx-on":
			"htmx:config:request from:self -> if (document.hidden) event.preventDefault()",
		"hx-swap": "outerMorph",
		"hx-trigger": "every 60s, visibilitychange from:document",
	}}
	class="mt-4 flex flex-col items-center gap-1"
	style="anchor-name: --anchor-tracker-info"
>
	<div class="flex gap-1">
		<div class="flex flex-col justify-evenly">
			<button
				hx-get="/tracker/charts/points"
				hx-swap="after"
				hx-target="main"
				hx-vals={JSON.stringify(params)}
				data-umami-event="tracker-chart-points"
				data-umami-event-kind={params.kind}
				data-umami-event-name={data.name}
				class="tooltip btn tooltip-start btn-square size-10 tooltip-secondary btn-secondary"
				data-tip="Points Chart"
			>
				<IconLoader class="size-5" name="lucide--chart-no-axes-combined" />
			</button>

			<button
				data-umami-event="tracker-discord-webhook"
				data-umami-event-kind={params.kind}
				data-umami-event-name={data.name}
				class="tooltip btn tooltip-bottom tooltip-start btn-square size-10 tooltip-secondary btn-secondary"
				data-tip="Subscribe to Discord Webhook"
				disabled={isPastData}
				popovertarget="tracker-discord-webhook"
			>
				<Icon class="size-5" name="lucide--megaphone" />
			</button>
			{
				!isPastData && (
					<div
						hx-morph-skip-children
						class="dropdown dropdown-center px-6 py-4"
						id="tracker-discord-webhook"
						popover
						style="position-anchor: --anchor-tracker-info"
					>
						<DiscordWebhook
							client:only="preact"
							target={pick(data, ["kind", "id"])}
						/>
					</div>
				)
			}
		</div>

		<img
			class="aspect-9/4 w-64"
			src={getTrackerLogo(data.id, params.kind)}
			alt={`${data.assetBundleName} logo`}
		/>

		<div class="flex flex-col justify-evenly">
			<button
				data-umami-event="tracker-info-audio"
				data-umami-event-kind={params.kind}
				data-umami-event-name={data.name}
				class="tooltip btn tooltip-end btn-square size-10 tooltip-secondary btn-secondary"
				data-tip="BGM Player"
				popovertarget="tracker-info-audio"
			>
				<Icon class="size-5" name="lucide--music" />
			</button>
			<div
				class="dropdown dropdown-center"
				id="tracker-info-audio"
				popover
				style="position-anchor: --anchor-tracker-info"
			>
				<audio
					src={getTrackerBgm(data.id, params.kind)}
					controls
					loop
					preload="metadata"></audio>
			</div>

			<button
				data-umami-event="tracker-info-images"
				data-umami-event-kind={params.kind}
				data-umami-event-name={data.name}
				class="tooltip btn tooltip-bottom tooltip-end btn-square size-10 tooltip-secondary btn-secondary"
				data-tip="Images"
				popovertarget="tracker-info-images"
			>
				<Icon class="size-5" name="lucide--wallpaper" />
			</button>
			<div
				class="dropdown dropdown-center h-64 px-2 py-0 sm:h-96"
				id="tracker-info-images"
				popover
				style="position-anchor: --anchor-tracker-info"
			>
				{
					([1, 2] as const).map((variant) => (
						<img
							class="aspect-2/1 h-64 rounded-box object-cover py-2 sm:h-96"
							src={getTrackerBackground(data.id, params.kind, variant)}
							alt={`${data.assetBundleName} background`}
							loading="lazy"
						/>
					))
				}
			</div>
		</div>
	</div>

	<h2 class="text-center text-lg font-semibold">
		<Icon
			class="htmx-indicator mr-1 align-[-2px]"
			id="metadata-loader"
			name="svg-spinners--90-ring-with-bg"
		/>

		{data.name}
	</h2>

	<div class="flex w-full flex-col">
		<div
			class="flex translate-y-1.5 justify-between px-0.5 text-sm font-medium"
		>
			<span
				{...!isPastData && {
					class:
						"tooltip tooltip-start tooltip-primary underline decoration-dotted",
					"data-tip": formatDuration({
						[isNotStarted ? "from" : "to"]: data.startAt,
					}),
				}}
				>{
					dayjs.tz(data.startAt, clientTimezone).format("YYYY-MM-DD, HH:mm")
				}</span
			>
			<span
				{...!isPastData && {
					class:
						"tooltip tooltip-end tooltip-primary underline decoration-dotted",
					"data-tip": formatDuration({ from: data.endAt }),
				}}
				>{
					dayjs.tz(data.endAt, clientTimezone).format("YYYY-MM-DD, HH:mm")
				}</span
			>
		</div>

		<div class="relative w-full">
			<progress
				class="progress w-full progress-primary"
				value={progress}
				max="100"></progress>

			<div class="absolute center badge badge-sm badge-primary">
				{progress.toFixed(1)}%
			</div>
		</div>
	</div>
</div>
