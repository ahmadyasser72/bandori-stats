---
import { capitalize, startCase } from "es-toolkit";
import z from "zod";

import { db } from "@bandori-stats/database";
import IconLoader from "~/components/icon-loader.astro";
import BaseLayout from "~/layouts/base-layout.astro";
import { getEventBanner, getTrackerLogo } from "~/lib/assets";

const TABS = ["event", "monthly"] as const;

const params = Astro.locals.parseQuery(
	z.object({
		tab: z.enum(TABS).catch("event"),
		id: z.coerce.number().optional(),
	}),
);

if (!params.id) {
	const latest = await Astro.locals.tracing.enterSpan(
		"fetch-latest-data",
		async (span) => {
			span.setAttribute("kind", params.tab);

			return params.tab === "event"
				? db().query.gbpEvents.findFirst({
						columns: { id: true },
						where: { snapshots: true },
						orderBy: { id: "desc" },
					})
				: db().query.gbpMonthlyRankings.findFirst({
						columns: { id: true },
						where: { snapshots: true },
						orderBy: { id: "desc" },
					});
		},
	);

	if (latest)
		return Astro.redirect(
			`${Astro.url.pathname}?id=${latest.id}&tab=${params.tab}`,
		);

	return new Response(null, { status: 404 });
}

const choices = await Astro.locals.tracing.enterSpan(
	"fetch-choices",
	(span) => {
		span.setAttribute("kind", params.tab);

		return params.tab === "event"
			? db().query.gbpEvents.findMany({
					columns: { id: true, name: true, assetBundleName: true },
				})
			: db().query.gbpMonthlyRankings.findMany({
					columns: { id: true, name: true, assetBundleName: true },
				});
	},
);

const TAB_ICON = {
	event: "lucide--calendar",
	monthly: "lucide--crown",
} as const;
---

<BaseLayout title="Tracker" containerClass="max-w-2xl" page="tracker">
	<fieldset class="tabs tabs-lg text-primary" id="tracker-tabs" role="tablist">
		{
			TABS.map((tab) => (
				<label class="tab hover:text-primary max-sm:flex-1 sm:px-16">
					<input
						hx-get="/tracker"
						hx-disable="closest .tabs"
						hx-swap="outerHTML transition:true"
						hx-target="main"
						data-umami-event="tracker-tab"
						data-umami-event-name={tab}
						name="tab"
						type="radio"
						value={tab}
						checked={params.tab === tab}
					/>
					<IconLoader class="mr-2 size-5" name={TAB_ICON[tab]} />
					{startCase(tab)}
				</label>
			))
		}
	</fieldset>

	<label class="select mx-auto mt-4 flex w-max max-w-full">
		<span class="label">
			<IconLoader name="lucide--calendars" />
			{capitalize(params.tab)}
		</span>
		<select
			hx-get="/tracker/list"
			hx-browser-indicator="true"
			hx-indicator="previous .label"
			hx-swap="outerHTML"
			hx-target="#tracker-list"
			hx-vals={JSON.stringify({ kind: params.tab })}
			class="min-w-48"
			name="id"
		>
			{
				choices.map(({ assetBundleName, id, name }) => (
					<option
						data-umami-event="tracker-select"
						data-umami-event-kind={params.tab}
						data-umami-event-name={name}
						value={id}
						selected={params.id === id}
					>
						<div class="flex flex-col items-center">
							<img
								class={
									params.tab === "event" ? "aspect-3/1 w-64" : "aspect-9/4 w-48"
								}
								src={
									params.tab === "event"
										? getEventBanner({ id })
										: getTrackerLogo({ kind: params.tab, id })
								}
								alt={assetBundleName}
								loading="lazy"
							/>
							<span class="text-center text-sm">{name}</span>
						</div>
					</option>
				))
			}
		</select>
	</label>

	<div class="contents" id="tracker-info"></div>

	<div
		hx-get="/tracker/list"
		hx-browser-indicator="true"
		hx-swap="outerHTML"
		hx-trigger="load"
		hx-vals={JSON.stringify({ kind: params.tab, id: params.id })}
		class="list mt-4 py-1"
		id="tracker-list"
	>
		{Array.from({ length: 5 }).map(() => <div class="list-row skeleton" />)}
	</div>
</BaseLayout>
