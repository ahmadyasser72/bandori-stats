---
import { capitalize } from "es-toolkit";

import { GBP_TIMEZONE } from "@bandori-stats/bestdori/constants";
import dayjs from "@bandori-stats/bestdori/date";
import { formatEventType } from "@bandori-stats/bestdori/helpers";
import {
	getTrackingMetadata,
	TrackingTarget,
} from "@bandori-stats/database/tracker";
import Icon from "~/components/icon.astro";
import SheetModal from "~/layouts/sheet-modal.astro";
import {
	getEventBanner,
	getTrackerBackground,
	getTrackerBgm,
	getTrackerLogo,
} from "~/lib/assets";

const params = Astro.locals.parseQuery(TrackingTarget);

const metadata = await Astro.locals.tracing.enterSpan(
	"fetch-metadata",
	async (span) => {
		span.setAttribute("kind", params.kind);
		span.setAttribute("id", params.id);

		return getTrackingMetadata(params);
	},
);
if (!metadata) return new Response(null, { status: 404 });

const kind = capitalize(params.kind);
const clientTimezone =
	Astro.request.headers.get("client-timezone") ?? GBP_TIMEZONE;
Astro.response.headers.append("vary", "client-timezone");
---

<SheetModal>
	<h2 class="text-center text-2xl font-medium capitalize">{metadata.name}</h2>

	<div class="tabs h-[60vh] text-accent" role="tablist">
		<label class="tab hover:text-accent max-sm:flex-1 sm:px-16">
			<input name="tracker-metadata" type="radio" checked />
			<Icon class="mr-2 size-5" name="lucide--info" />
			Metadata
		</label>
		<div class="tab-content text-base-content">
			<div class="flex flex-col items-center gap-2 text-center">
				<div>
					<h3 class="font-medium">{kind} Period</h3>
					<span>
						{[metadata.startAt, metadata.endAt]
							.map((date) =>
								dayjs.tz(date, clientTimezone).format("DD MMM YYYY, HH:mm"),
							)
							.join(" — ")}
					</span>
				</div>

				{metadata.kind === "event" && (
					<>
						<div>
							<h3 class="font-medium">Event Type</h3>
							<span class="inline-flex items-center gap-1">
								<img
									class="size-5"
									src={`/assets/attributes/${metadata.metadata.attributes[0].attribute}.svg`}
								/>
								{formatEventType(metadata.type)}
							</span>
						</div>

						<div>
							<h3 class="font-medium">Event Characters</h3>
							<span class="inline-flex gap-1">
								{Object.keys(metadata.metadata.characters).map((id) => (
									<img class="size-10" src={`/assets/characters/${id}.webp`} />
								))}
							</span>
						</div>

						<div>
							<h3 class="font-medium">Event Gacha Cards</h3>
							<span class="inline-flex flex-wrap justify-center gap-1">
								{Object.keys(metadata.metadata.members).flatMap((id) =>
									["normal", "trained"].map((variant) => (
										<img
											class="size-12 rounded-box"
											src={`/assets/cards/${id}-${variant}-icon.webp`}
										/>
									)),
								)}
							</span>
						</div>
					</>
				)}
			</div>
		</div>

		<label class="tab hover:text-accent max-sm:flex-1 sm:px-16">
			<input name="tracker-metadata" type="radio" />
			<Icon class="mr-2 size-5" name="lucide--library" />
			Assets
		</label>
		<div class="tab-content overflow-y-auto text-base-content">
			<div class="flex flex-col items-center gap-4 text-center">
				<div>
					<h3 class="font-medium">{kind} BGM</h3>
					<audio
						src={getTrackerBgm(params)}
						controls
						loop
						preload="metadata"
					></audio>
				</div>

				{metadata.kind === "event" && (
					<div>
						<h3 class="font-medium">Event Banner</h3>
						<img
							class="my-2 aspect-3/1 w-64"
							src={getEventBanner(params)}
							alt={metadata.assetBundleName}
							loading="lazy"
						/>
					</div>
				)}

				<div>
					<h3 class="font-medium">{kind} Logo</h3>
					<img
						class="my-2 aspect-9/4"
						src={getTrackerLogo(params)}
						alt={metadata.assetBundleName}
						loading="lazy"
					/>
				</div>

				<div>
					<h3 class="font-medium">{kind} Background</h3>
					{([1, 2] as const).map((variant) => (
						<img
							class="my-2 aspect-2/1 h-64 rounded-box object-cover sm:h-96"
							src={getTrackerBackground(params, variant)}
							alt={`${metadata.assetBundleName} background`}
							loading="lazy"
						/>
					))}
				</div>
			</div>
		</div>
	</div>
</SheetModal>
