---
import * as devalue from "devalue";
import MiniSearch from "minisearch";
import {
	leaderboards,
	titlesDisplay,
	type Category,
} from "virtual:bandori-leaderboard";
import z from "zod";

import Icon from "~/components/icon.astro";
import InfiniteGridLoader from "~/components/infinite-grid-loader.astro";
import { filterTerms, highlight } from "~/lib/highlight";
import { paginate } from "~/lib/paginate";
import { QuerySchema } from "~/lib/schema";

export const partial = true;

const searchFields = [
	"name",
	"attribute",
	"type",
	"band",
	"characters",
	"username",
	"nickname",
] as const;
const params = Astro.locals.parseQuery(z.object({ query: QuerySchema }));
const { events, suggestions = [] } = await (async () => {
	const values = Object.values(leaderboards.events).reverse();
	if (!params.query) return { events: values };

	const index = new MiniSearch<(typeof values)[number]>({
		searchOptions: {
			combineWith: "OR",
			fuzzy: true,
			prefix: true,
			boost: { name: 2, characters: 1.5, username: 0.5, nickname: 0.5 },
		},
		fields: [...searchFields],
		extractField: (document, fieldName) => {
			if (fieldName === "band") return document.band.name;
			if (fieldName === "characters")
				return document.characters.map(({ name }) => name);
			if (fieldName === "username")
				return Object.values(document.items).flatMap((players) =>
					players.map(({ player }) => player.username),
				);
			if (fieldName === "nickname")
				return Object.values(document.items).flatMap((players) =>
					players.map(({ player }) => player.nickname),
				);

			return document[fieldName as never];
		},
	});
	index.addAll(values);

	return {
		events: index
			.search(params.query)
			.sort((a, b) => b.score - a.score || b.id - a.id)
			.map(({ id, match }) => {
				const event = leaderboards.events[id];
				const usernameTerms = filterTerms(match, "username");
				const nicknameTerms = filterTerms(match, "nickname");

				if (usernameTerms.length === 0 && nicknameTerms.length === 0)
					return { match, ...event };

				const matchedPositions = new Map<
					`${Category}:${number}`,
					{ username: string[]; nickname: string[] }
				>();
				for (const [category, players] of Object.entries(event.items)) {
					for (const [idx, { player }] of players.entries()) {
						const terms = {
							username: usernameTerms.filter((term) =>
								player.username.toLowerCase().includes(term),
							),
							nickname: nicknameTerms.filter((term) =>
								player.nickname?.toLowerCase().includes(term),
							),
						};

						if (terms.username.length || terms.nickname.length)
							matchedPositions.set(`${category}:${idx}`, terms);
					}
				}

				return { match, matchedPositions, ...event };
			}),
		suggestions: index
			.autoSuggest(params.query)
			.slice(0, 10)
			.map(({ suggestion }) => suggestion),
	};
})();

const highlightTerms = (
	data: (typeof events)[number],
	text: string,
	key: (typeof searchFields)[number],
) => {
	if (!("match" in data)) return text;
	const terms = filterTerms(data.match, key);
	return highlight(text, terms);
};

const page = await paginate<(typeof events)[number]>({
	items: events,
	context: Astro,
	size: 12,
	extraProps: {
		"hx-swap": "outerHTML",
		"hx-vals": JSON.stringify(params),
	},
});

if (Astro.cache.enabled) {
	Astro.cache.set({ etag: `"${__GIT_HASH__}"`, maxAge: 60 * 60 });
}
---

<hx-partial hx-target="#event-search-suggestions">
	{suggestions.map((value) => <option {value} />)}
</hx-partial>

{
	page.items.length === 0 && (
		<div class="card col-span-full py-16">
			<div class="card-body items-center text-center">
				<Icon class="size-16 opacity-50" name="lucide--search-x" />
				<h2 class="card-title text-lg">No events found</h2>
			</div>
		</div>
	)
}

{
	page.items.map((event) => (
		<div class="card">
			<figure>
				<img
					class="aspect-3/1 w-full max-w-100 sm:mt-8"
					src={`/static/events/${event.id}-banner.webp`}
					loading="lazy"
				/>
			</figure>
			<div class="card-body items-center">
				<h2
					class="card-title flex-1 items-center text-center"
					set:html={highlightTerms(event, event.name, "name")}
				/>

				<div class="my-2 flex flex-col justify-center gap-2">
					<div class="flex flex-wrap justify-center gap-x-2 gap-y-1.5">
						<div
							class="badge badge-soft badge-md badge-primary"
							set:html={highlightTerms(event, event.type, "type")}
						/>

						<div class="badge badge-soft badge-md uppercase badge-primary">
							<img
								class="size-4"
								src={`/static/attributes/${event.attribute}.svg`}
							/>
							<span
								set:html={highlightTerms(event, event.attribute, "attribute")}
							/>
						</div>

						<div class="badge badge-soft badge-md badge-primary">
							{event.band.id === 0 ? (
								<span set:html={highlightTerms(event, "MIXED", "band")} />
							) : (
								<>
									<img
										class="size-4"
										src={`/static/bands/${event.band.id}.svg`}
									/>
									<span
										set:html={highlightTerms(event, event.band.name, "band")}
									/>
								</>
							)}
						</div>
					</div>

					<div class="flex max-w-96 flex-wrap items-start justify-center gap-x-2 gap-y-1.5">
						{event.characters.map(({ id, name }) => (
							<div class="badge badge-soft badge-accent sm:badge-lg">
								<img class="size-5" src={`/static/characters/${id}.webp`} />
								<span set:html={highlightTerms(event, name, "characters")} />
							</div>
						))}
					</div>
				</div>

				<div
					class="card-actions w-full max-w-64"
					style={`anchor-name: --anchor-event-${event.id}-actions`}
				>
					<div class="indicator flex-1 indicator-center indicator-bottom">
						{"matchedPositions" in event && event.matchedPositions.size > 0 && (
							<div class="pointer-events-none indicator-item badge badge-soft badge-xs badge-primary">
								{event.matchedPositions.size} match
							</div>
						)}
						<button
							class="btn w-full btn-primary btn-sm"
							popovertarget={`event-${event.id}-detail`}
						>
							<Icon name="lucide--list" />
							Detail
						</button>
					</div>
					<div
						class="dropdown dropdown-center dropdown-top w-80 sm:w-md"
						id={`event-${event.id}-detail`}
						popover
						style={`position-anchor: --anchor-event-${event.id}-actions`}
					>
						<div
							hx-get="/leaderboard/events/list"
							hx-target:inherited="this"
							hx-trigger="intersect once"
							class="max-h-64 overflow-y-auto px-2 py-1"
							hx-vals:inherited={JSON.stringify({
								event: event.id,
								...("matchedPositions" in event && {
									matches:
										event.matchedPositions.size > 0
											? devalue.stringify(event.matchedPositions)
											: undefined,
								}),
							})}
						>
							<div class="list">
								{Array.from({ length: 5 }).map(() => (
									<div class="list-row skeleton" />
								))}
							</div>
						</div>
					</div>

					<button
						class="btn btn-secondary btn-sm"
						popovertarget={`event-${event.id}-preview`}
					>
						<Icon name="lucide--eye" />
						Preview ({event.count})
					</button>
					<div
						class="dropdown dropdown-center dropdown-top w-max max-w-64"
						id={`event-${event.id}-preview`}
						popover
						style={`position-anchor: --anchor-event-${event.id}-actions`}
					>
						<div class="flex flex-wrap justify-center gap-x-1 gap-y-0.5">
							{Object.entries(event.items).map(([category, items]) => (
								<div
									class:list={[
										"badge badge-soft badge-sm",
										category.startsWith("event-") && "badge-primary",
										(category.startsWith("song-") ||
											category.endsWith("live-goals")) &&
											"badge-accent",
									]}
								>
									{titlesDisplay[category]}{" "}
									{!category.match(/t[123]$/) && `(${items.length})`}
								</div>
							))}
						</div>
					</div>
				</div>
			</div>
		</div>
	))
}

{page.hasNextPage && <InfiniteGridLoader item="events" {...page.props} />}
