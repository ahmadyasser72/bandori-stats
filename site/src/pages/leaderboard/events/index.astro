---
import IconLoader from "~/components/icon-loader.astro";

export const partial = true;
---

<hx-partial hx-target="#leaderboard-tab-actions">
	<div class="mt-4 flex justify-center">
		<label class="input">
			<IconLoader name="lucide--search" />
			<input
				hx-get="/leaderboard/events/items"
				hx-sync="this:replace"
				hx-target="#leaderboard-cards"
				hx-trigger="input changed delay:300ms, intersect once"
				name="query"
				type="search"
				list="event-search-suggestions"
				placeholder="search events/players..."
			/>
			<datalist id="event-search-suggestions"></datalist>
		</label>
	</div>
</hx-partial>

{
	Array.from({ length: 4 }).map(() => (
		<div class="card h-100">
			<div class="card-body m-8 skeleton p-0" />
		</div>
	))
}
