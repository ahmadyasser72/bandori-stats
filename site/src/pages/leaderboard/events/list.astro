---
import {
	accountHasNickname,
	countBy,
	groupBy,
	sortKeys,
} from "@bandori-stats/bestdori/helpers";

import * as devalue from "devalue";
import {
	leaderboards,
	type Category,
	type PlayerData,
} from "virtual:bandori-leaderboard";
import z from "zod";

import IconLoader from "~/components/icon-loader.astro";
import { getProfileIcon, getTitleImage } from "~/lib/assets";
import { highlight } from "~/lib/highlight";

export const partial = true;

const params = Astro.locals.parseQuery(
	z.object({
		event: z.coerce.number().refine((id) => id in leaderboards.events, {
			error: "event unavailable",
		}),
		group: z.enum(["event", "song", "goals"]).catch("event"),
		matches: z
			.string()
			.optional()
			.transform(
				(
					match,
				): Map<
					`${Category}:${number}`,
					{ username: string[]; nickname: string[] }
				> => (match ? devalue.parse(match) : new Map()),
			),
	}),
);

interface PlayeDataHighlight extends PlayerData {
	terms?: { username: string[]; nickname: string[] };
}

const matchedEntries = [] as [Category, PlayeDataHighlight[]][];

const playerEntries = Object.entries(
	leaderboards.events[params.event].items,
).map(([category, players]): [Category, PlayeDataHighlight[]] => {
	if (params.matches.size === 0) return [category, players];

	const unmatched: PlayeDataHighlight[] = [];
	for (const [idx, { player, titles }] of players.entries()) {
		const terms = params.matches.get(`${category}:${idx}`);
		if (terms) {
			matchedEntries.push([category, [{ player, titles, terms }]]);
		} else {
			unmatched.push({ player, titles });
		}
	}
	return [category, unmatched];
});

const groupCategory = (category: Category) => {
	if (category.startsWith("event")) return "event" as const;
	if (category.startsWith("song")) return "song" as const;
	if (category.endsWith("live-goals")) return "goals" as const;
	throw new Error(`invalid category while grouping event items: ${category}`);
};

const groups = sortKeys(
	groupBy([...matchedEntries, ...playerEntries], ([category]) =>
		groupCategory(category),
	),
);

const matchCounts = countBy(matchedEntries, ([category]) =>
	groupCategory(category),
);

const isPodium = (category: Category) => category.match(/t[123]$/);
const getCategoryLabel = (category: Category) => {
	if (category === "ex-live-goals") return "EX";
	if (category === "live-goals") return "N";
	return `T${category.split("-t").at(-1)!}`;
};

const GROUP_ICONS = {
	event: "lucide--calendar",
	song: "lucide--music",
	goals: "lucide--target",
} as const;

const GROUP_LABELS = {
	event: "Event Points",
	song: "Song Ranking",
	goals: "Live Goals",
};
---

<fieldset class="tabs text-accent" role="tablist">
	{
		Object.keys(groups).map((group) => (
			<label class="tab indicator flex-1 indicator-center indicator-bottom hover:text-accent">
				<input
					hx-get="/leaderboard/events/list"
					class="peer"
					name="group"
					type="radio"
					value={group}
					hx-disable="closest .tabs"
					checked={params.group === group}
				/>
				<IconLoader class="mr-2 size-5" name={GROUP_ICONS[group]} />
				{GROUP_LABELS[group]}

				{matchCounts[group] > 0 && (
					<span class="pointer-events-none indicator-item badge badge-xs badge-accent not-peer-checked:badge-soft">
						{matchCounts[group]}
					</span>
				)}
			</label>
		))
	}
</fieldset>

<div class="list mt-4">
	{
		groups[params.group].map(([category, players]) =>
			players.map(({ player, titles, terms }) => (
				<div
					class:list={[
						isPodium(category) && "aura not-last:mb-1.5",
						category.endsWith("-t1") && "aura-holo",
						category.endsWith("-t2") && "aura-gold",
						category.endsWith("-t3") && "aura-silver",
					]}
				>
					<div
						class:list={[
							"list-row items-center",
							isPodium(category) && "bg-base-100 dark:bg-base-300",
						]}
					>
						<span
							class:list={[
								"badge min-h-8 min-w-8 font-mono",
								category.endsWith("-t1") && "badge-primary",
								category.endsWith("-t2") && "badge-accent",
								category.endsWith("-t3") && "badge-secondary",
								!isPodium(category) && "badge-ghost",
							]}
						>
							{getCategoryLabel(category)}
						</span>

						<div class="flex min-w-0 items-center gap-2 list-col-grow">
							{player.profileArt && (
								<div class="avatar">
									<div class="size-10 rounded-box">
										<img
											src={getProfileIcon(player)}
											alt={player.username}
											loading="lazy"
										/>
									</div>
								</div>
							)}

							{accountHasNickname(player) ? (
								<div class="flex min-w-0 flex-col">
									<span
										class="truncate font-medium text-ellipsis"
										set:html={highlight(player.nickname!, terms?.nickname)}
									/>
									<span
										class="truncate text-xs text-ellipsis text-base-content/67"
										set:html={highlight(`@${player.username}`, terms?.username)}
									/>
								</div>
							) : (
								<span
									class="truncate text-lg font-medium text-ellipsis"
									set:html={highlight(`@${player.username}`, terms?.username)}
								/>
							)}
						</div>

						<img
							class="aspect-23/5 w-36 rounded-2xl max-sm:list-col-wrap"
							src={getTitleImage(titles[0])}
							loading="lazy"
						/>
					</div>
				</div>
			)),
		)
	}
</div>
