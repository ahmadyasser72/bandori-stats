---
import {
	accountHasNickname,
	displayValue,
} from "@bandori-stats/bestdori/helpers";
import type { Account } from "@bandori-stats/database/schema";

import type { MatchInfo } from "minisearch";

import { filterTerms, highlight } from "~/lib/highlight";
import { getProfileIcon } from "~/lib/image";

interface Props {
	players: (Pick<Account, "id" | "username" | "nickname" | "profileArt"> & {
		value: number;
		trueRank?: number;
		match?: MatchInfo;
	})[];
	anchor?: string;
}

const players = (() => {
	let trueRank = 0;
	return Astro.props.players.map((player, idx) => {
		if (player.trueRank) return { player, trueRank: player.trueRank };

		if (idx === 0 || player.value !== Astro.props.players[idx - 1].value)
			trueRank = idx;
		return { player, trueRank };
	});
})();

const highlightTerms = (
	data: (typeof players)[number]["player"],
	text: string,
	key: "username" | "nickname",
) => {
	if (!("match" in data) || !data.match) return text;
	const terms = filterTerms(data.match, key);
	return highlight(text, terms);
};

const AURA_DURATION = [15_000, 12_000, 9_000];
---

{
	players.map(({ player, trueRank }) => (
		<div
			class:list={[
				"group",
				trueRank < 3 && "aura not-last:mb-1.5",
				trueRank === 0 && "aura-holo",
				trueRank === 1 && "aura-gold",
				trueRank === 2 && "aura-silver",
			]}
			style={
				trueRank < 3 &&
				`transition-duration: ${AURA_DURATION[trueRank] + (player.id % 10) * 100}ms`
			}
		>
			<div
				class:list={[
					"list-row items-center",
					trueRank < 3 && "bg-base-100 dark:bg-base-300",
				]}
				style={
					Astro.props.anchor &&
					`anchor-name: --anchor-${player.id}-${Astro.props.anchor}`
				}
			>
				<span
					class:list={[
						"badge min-h-8 min-w-8",
						trueRank === 0 && "badge-primary",
						trueRank === 1 && "badge-accent",
						trueRank === 2 && "badge-secondary",
						trueRank > 2 && "badge-ghost",
					]}
				>
					{trueRank + 1}
				</span>

				<div class="list-col-grow flex min-w-0 items-center gap-2">
					{player.profileArt && (
						<div class="avatar">
							<div class="size-10 rounded-box">
								<img
									src={getProfileIcon(player)}
									alt={player.username}
									loading="lazy"
								/>
							</div>
						</div>
					)}

					{accountHasNickname(player) ? (
						<div class="flex min-w-0 flex-col">
							<span
								class="truncate font-medium text-ellipsis"
								set:html={highlightTerms(player, player.nickname!, "nickname")}
							></span>
							<span
								class="truncate text-xs text-ellipsis text-base-content/67"
								set:html={highlightTerms(
									player,
									`@${player.username}`,
									"username",
								)}
							></span>
						</div>
					) : (
						<span
							class="truncate text-lg font-medium text-ellipsis"
							set:html={highlightTerms(
								player,
								`@${player.username}`,
								"username",
							)}
						/>
					)}
				</div>

				<span
					class="font-mono text-sm max-sm:list-col-wrap"
					set:html={
						Astro.slots.has("value")
							? Astro.slots.render("value", [player])
							: displayValue(player.value)
					}
				/>
			</div>
		</div>
	))
}
