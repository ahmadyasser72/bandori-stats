---
import z from "zod";

import { STAT_NAMES } from "@bandori-stats/bestdori/constants";
import { db } from "@bandori-stats/database";
import {
	PLAYER_STATS_SORTED_SET_PREFIX,
	redis,
} from "@bandori-stats/database/redis";
import InfiniteListLoader from "~/components/infinite-list-loader.astro";
import { paginate } from "~/lib/paginate";
import LeaderboardTopList from "../_leaderboard-top-list.astro";

export const partial = true;

const { stat } = Astro.locals.parseQuery(
	z.object({ stat: z.enum(STAT_NAMES) }),
);

const page = await paginate({
	items: {
		get: async (limit, offset) => {
			const topPlayers = await (async () => {
				const TOP_SIZE = 100;
				const key = `${PLAYER_STATS_SORTED_SET_PREFIX}:${stat}`;
				const results = await redis().zrange<number[]>(key, 0, TOP_SIZE - 1, {
					rev: true,
					withScores: true,
				});

				let trueRank = 0;
				const topData = Array.from({ length: results.length / 2 }, (_, idx) => {
					const id = results[idx * 2];
					const value = results[idx * 2 + 1];
					if (idx === 0 || value !== results[(idx - 1) * 2 + 1]) trueRank = idx;
					return { id, value, trueRank };
				});

				const last = topData.at(-1)!;
				const ids = await redis().zrange<number[]>(key, "+inf", last.value, {
					rev: true,
					byScore: true,
				});

				if (ids.length > topData.length) {
					topData.push(...ids.slice(TOP_SIZE).map((id) => ({ ...last, id })));
				}

				return topData;
			})();

			const paged = topPlayers.slice(offset, offset + limit);
			const players = await db().query.accounts.findMany({
				columns: { id: true, username: true, nickname: true, profileArt: true },
				where: { id: { in: paged.map(({ id }) => id) } },
			});

			return {
				items: paged.map(({ id, ...data }) => ({
					player: players.find((player) => player.id === id)!,
					...data,
				})),
				hasNextPage: offset + limit < topPlayers.length,
			};
		},
	},
	context: Astro,
	size: 10,
	params: { stat },
});
---

<LeaderboardTopList players={page.items} />

{page.hasNextPage && <InfiniteListLoader {...page.props} />}
