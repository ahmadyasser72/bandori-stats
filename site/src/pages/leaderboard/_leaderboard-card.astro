---
import { startCase } from "@bandori-stats/bestdori/helpers";
import type { Snapshot } from "@bandori-stats/database/schema";

import Icon from "~/components/icon.astro";
import { STAT_ICONS } from "~/lib/stats";

interface Props {
	name: keyof Snapshot["stats"];
	title?: string;
}

const { name, title } = Astro.props;
---

<div class="card">
	<div class="card-body px-0">
		<h2 class="card-title self-center">
			<Icon class="text-primary" name={STAT_ICONS[name]} />
			{title ?? startCase(name)}
		</h2>

		<slot />
	</div>
</div>
