---
import { uniqBy } from "@bandori-stats/bestdori/helpers";

import {
	categories,
	leaderboards,
	titlesDisplay,
} from "virtual:bandori-leaderboard";
import z from "zod";

import IconLoader from "~/components/icon-loader.astro";
import { QuerySchema } from "~/lib/schema";
import LeaderboardCard from "~/pages/leaderboard/_leaderboard-card.astro";
import { playerSearchIndex } from "./_player-search";

export const partial = true;

const groups = {
	event: {
		label: "Event Rank",
		icon: "lucide--calendar",
		items: categories.filter((it) => it.startsWith("event-")),
	},
	song: {
		label: "Song Rank",
		icon: "lucide--music",
		items: categories.filter((it) => it.startsWith("song-")),
	},
	goals: {
		label: "Live Goals",
		icon: "lucide--target",
		items: categories.filter((it) => it.endsWith("live-goals")),
	},
	monthly: {
		label: "Monthly Ranking",
		icon: "lucide--crown",
		items: categories.filter((it) => it.startsWith("monthly-")),
	},
} as const;

const params = Astro.locals.parseQuery(
	z.object({
		group: z.enum(["event", "song", "monthly", "goals"]).catch("event"),
		query: QuerySchema,
	}),
);

const suggestions = [] as string[];
if (params.query) {
	const categories = groups[params.group].items;
	const players = uniqBy(
		categories.flatMap((category) => leaderboards.global[category]),
		({ id }) => id,
	);
	const index = playerSearchIndex(players);
	suggestions.push(
		...index
			.autoSuggest(params.query)
			.slice(0, 10)
			.map(({ suggestion }) => suggestion),
	);
}
---

<hx-partial hx-target="#leaderboard-tab-actions">
	<div class="mt-4 flex flex-col items-center gap-2">
		<label class="input">
			<IconLoader name="lucide--search" />
			<input
				hx-get="/leaderboard/titles"
				hx-target="#leaderboard-cards"
				hx-trigger="input changed delay:300ms, intersect once"
				id="titles-search"
				name="query"
				type="search"
				hx-include=".tabs input"
				hx-preserve="true"
				hx-select-oob="#titles-search-suggestions"
				hx-sync="this:replace"
				list="titles-search-suggestions"
				placeholder="search players in top 100..."
			/>
			<datalist id="titles-search-suggestions">
				{suggestions.map((value) => <option {value} />)}
			</datalist>
		</label>
		<fieldset class="tabs w-full tabs-sm text-accent" role="tablist">
			{
				Object.entries(groups).map(([name, { icon, label }]) => (
					<label class="tab h-16 flex-col hover:text-accent max-md:flex-1 md:px-12">
						<input
							hx-get="/leaderboard/titles"
							hx-target="#leaderboard-cards"
							name="group"
							type="radio"
							value={name}
							hx-browser-indicator="true"
							hx-disable="closest .tabs"
							hx-include="#titles-search"
							hx-replace-url={`/leaderboard?tab=titles-${name}`}
							checked={name === params.group}
						/>
						<IconLoader class="size-5" name={icon} />
						<span class="max-sm:hidden">{label}</span>
						<span class="sm:hidden">{label.replace(/Rank.*/, "")}</span>
					</label>
				))
			}
		</fieldset>
	</div>
</hx-partial>

{
	groups[params.group].items.map((category) => (
		<LeaderboardCard name="titles" title={titlesDisplay[category]}>
			<div
				hx-get="/leaderboard/titles/list"
				hx-trigger="intersect once"
				class="list mt-1 max-h-100 overflow-y-auto px-8 py-1"
				hx-vals={JSON.stringify({ category, query: params.query })}
			>
				{Array.from({ length: 5 }).map(() => (
					<div class="list-row skeleton" />
				))}
			</div>
		</LeaderboardCard>
	))
}
