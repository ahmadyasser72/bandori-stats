---
import { groupBy } from "@bandori-stats/bestdori/helpers";

import {
	categories,
	categoryByTitle,
	displayCategory,
	leaderboards,
} from "virtual:bandori-leaderboard";
import z from "zod";

import { getTitleImage } from "~/lib/assets";
import { paginate } from "~/lib/paginate";
import { IdSchema } from "~/lib/schema";

export const partial = true;

const { category } = Astro.locals.parseQuery(
	z.object({ category: z.enum(Object.keys(leaderboards.global)) }),
);

const leaderboard = leaderboards.global[category];
const idx = IdSchema.refine(
	(id) => id < leaderboard.length,
	"player idx out of bound",
).parse(Astro.params.idx);

const grouped = groupBy(leaderboard[idx].titles, (id) =>
	categoryByTitle.get(id)!,
);
const titlesWithCategory = categories
	.reverse()
	.filter((category) => category in grouped)
	.flatMap((category) => grouped[category].map((id) => ({ category, id })));

const page = await paginate({
	items: titlesWithCategory,
	context: Astro,
	size: 120,
	extraProps: { "hx-swap": "after" },
});
---

{
	page.items.map(({ id, category }, idx, items) => (
		<>
			{((idx === 0 &&
				(page.current === 1 ||
					titlesWithCategory[page.size * (page.current - 1) - 1].category !==
						category)) ||
				(idx > 0 && items[idx - 1].category !== category)) && (
				<div class="divider my-1 basis-full">
					<div class="badge badge-sm font-medium badge-accent">
						{grouped[category].length} &mdash; {displayCategory[category]}
					</div>
				</div>
			)}

			<img
				{...(page.isLastElement(idx) && page.props)}
				class="aspect-23/5 rounded-2xl"
				src={getTitleImage(id)}
				loading="lazy"
			/>
		</>
	))
}
