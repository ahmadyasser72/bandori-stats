---
import { categories, leaderboards } from "virtual:bandori-leaderboard";
import z from "zod";

import Icon from "~/components/icon.astro";
import TitlesLoader from "~/components/titles-loader.astro";
import { paginate } from "~/lib/paginate";
import LeaderboardTopList from "~/pages/leaderboard/_leaderboard-top-list.astro";

export const partial = true;

const { category } = Astro.locals.parseQuery(
	z.object({ category: z.enum(categories) }),
);

const players = (() => {
	const all = leaderboards.global[category].map((player, idx) => ({
		idx,
		...player,
		value: player.titles.length,
	}));

	let trueRank = 0;
	return all.map((player, idx) => {
		if (idx === 0 || player.value !== all[idx - 1].value) trueRank = idx;
		return { ...player, trueRank };
	});
})();

const page = await paginate({
	items: players,
	context: Astro,
	size: 10,
	extraProps: {
		"hx-swap": "outerHTML",
		"hx-indicator": "this",
		"hx-vals": JSON.stringify({ category }),
	},
});
---

<LeaderboardTopList anchor={category} players={page.items}>
	<fragment slot="value">
		{
			(player: (typeof players)[number]) => (
				<>
					<div class="flex items-center gap-2 lg:flex-row-reverse">
						<button
							class="btn btn-square btn-soft btn-primary btn-xs"
							popovertarget={`titles-${player.id}-${category}`}
						>
							<Icon name="lucide:eye" />
						</button>
						<div
							class="dropdown dropdown-bottom group-nth-last-[-n+3]:dropdown-top lg:dropdown-end"
							id={`titles-${player.id}-${category}`}
							popover
							style={`position-anchor: --anchor-${player.id}-${category}`}
						>
							<TitlesLoader
								hx-vals:inherited={JSON.stringify({ category })}
								size={player.titles.length}
								url={`/leaderboard/titles/for/${player.idx}`}
							/>
						</div>

						<div>
							{player.value} title{player.value > 1 && "s"}
						</div>
					</div>
				</>
			)
		}
	</fragment>
</LeaderboardTopList>

{
	page.hasNextPage && (
		<div class="list-row items-center" {...page.props}>
			<div class="badge size-8 badge-ghost">~</div>
			<div class="list-col-grow flex items-center gap-2">
				<Icon class="size-10" name="svg-spinners:bars-scale-middle" />
				<span class="text-lg font-medium">Loading players...</span>
			</div>
			<span class="font-mono text-sm max-sm:list-col-wrap">X titles</span>
		</div>
	)
}
