---
import { categories, leaderboards } from "virtual:bandori-leaderboard";
import z from "zod";

import Icon from "~/components/icon.astro";
import InfiniteListLoader from "~/components/infinite-list-loader.astro";
import TitlesLoader from "~/components/titles-loader.astro";
import { paginate } from "~/lib/paginate";
import { QuerySchema } from "~/lib/schema";
import LeaderboardTopList from "~/pages/leaderboard/_leaderboard-top-list.astro";
import { playerSearchIndex } from "./_player-search";

export const partial = true;

const params = Astro.locals.parseQuery(
	z.object({ category: z.enum(categories), query: QuerySchema }),
);

const players = (() => {
	const all = leaderboards.global[params.category].map(
		({ player, titles }, idx) => ({
			idx,
			player,
			titles,
			value: titles.length,
		}),
	);

	let trueRank = 0;
	const withRank = all.map((data, idx) => {
		if (idx === 0 || data.value !== all[idx - 1].value) trueRank = idx;
		return { ...data, trueRank };
	});
	if (!params.query) return withRank;

	const index = playerSearchIndex(withRank);
	const matches = Object.fromEntries(
		index.search(params.query).map(({ id, match }) => [id, match]),
	);

	return withRank
		.filter(({ player }) => player.id in matches)
		.map((data) => ({ ...data, match: matches[data.player.id] }));
})();

const page = await paginate<(typeof players)[number]>({
	items: players,
	context: Astro,
	size: 10,
	params,
});
---

{
	players.length === 0 && (
		<div class="list-row items-center">
			<div class="flex items-center justify-center gap-2 list-col-grow">
				<Icon class="size-10" name="lucide--x" />
				<span class="text-lg font-medium">No players found</span>
			</div>
		</div>
	)
}

<LeaderboardTopList anchor={params.category} players={page.items}>
	<fragment slot="value">
		{
			({ idx, player, value }: (typeof players)[number]) => (
				<>
					<div class="flex items-center gap-2 lg:flex-row-reverse">
						<button
							data-umami-event="view-player-titles"
							data-umami-event-category={params.category}
							data-umami-event-id={player.id}
							data-umami-event-username={player.username}
							class="btn btn-square btn-soft btn-primary btn-xs"
							popovertarget={`titles-${player.id}-${params.category}`}
						>
							<Icon name="lucide--eye" />
						</button>
						<div
							class="dropdown dropdown-center dropdown-bottom group-nth-last-[-n+3]:dropdown-top lg:dropdown-end"
							id={`titles-${player.id}-${params.category}`}
							popover
							style={`position-anchor: --anchor-${player.id}-${params.category}`}
						>
							<TitlesLoader
								hx-vals:inherited={JSON.stringify({
									category: params.category,
								})}
								size={value}
								url={`/leaderboard/titles/for/${idx}`}
							/>
						</div>

						<div>
							{value} title{value > 1 && "s"}
						</div>
					</div>
				</>
			)
		}
	</fragment>
</LeaderboardTopList>

{page.hasNextPage && <InfiniteListLoader {...page.props} />}
