---
import IconLoader from "~/components/icon-loader.astro";
import Icon from "~/components/icon.astro";
import BaseLayout, { LINKS, PAGES } from "~/layouts/base-layout.astro";
import ThemeSelector from "~/layouts/components/theme-selector.astro";
---

<BaseLayout title="Homepage" page={null}>
	<div class="absolute inset-0 flex flex-col items-center justify-center">
		<div class="flex items-center gap-2">
			<h1 class="font-medium" style="view-transition-name: site-heading">
				bandori-stats
			</h1>
			<ThemeSelector compact />
		</div>

		<div class="mt-4 flex flex-wrap justify-center gap-2">
			{
				Object.values(PAGES).map(({ icon, label, url }) => (
					<a class="btn btn-primary btn-sm" href={url}>
						<IconLoader name={icon} />
						{label}
					</a>
				))
			}
		</div>

		<div class="mt-2 flex flex-wrap justify-center gap-2">
			{
				LINKS.map(({ icon, label, url }) => (
					<a class="btn btn-secondary" href={url} target="_blank">
						<Icon class="size-5" name={icon} />
						{label}
					</a>
				))
			}
		</div>
	</div>
</BaseLayout>
