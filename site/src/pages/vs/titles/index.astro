---
import { startCase } from "es-toolkit";
import z from "zod";

import { db } from "@bandori-stats/database";
import IconLoader from "~/components/icon-loader.astro";
import SheetModal from "~/layouts/sheet-modal.astro";
import { IdSchema, IsoDateWithDefault } from "~/lib/schema";

export const partial = true;

const params = Astro.locals.parseQuery(
	z.object({
		"player-1": IdSchema,
		"player-2": IdSchema,
		date: IsoDateWithDefault,
	}),
);

const [player1, player2] = await Promise.all(
	[params["player-1"], params["player-2"]].map((id) =>
		db().query.accounts.findFirst({
			columns: { id: true, username: true, nickname: true, profileArt: true },
			where: { id },
			with: {
				snapshots: {
					limit: 1,
					columns: { snapshotDate: true, stats: true },
					where: { snapshotDate: { lte: params.date } },
					orderBy: { snapshotDate: "desc" },
				},
			},
		}),
	),
);

const sets = {
	player1: new Set(player1?.snapshots[0].stats.titles ?? []),
	player2: new Set(player2?.snapshots[0].stats.titles ?? []),
};

const DISPLAYS = ["only-player-1", "both", "only-player-2"] as const;

const usernames = {
	"only-player-1": player1!.username,
	"only-player-2": player2!.username,
} satisfies Record<Exclude<(typeof DISPLAYS)[number], "both">, string>;
const displayCount = {
	"only-player-1": sets.player1.difference(sets.player2).size,
	"only-player-2": sets.player2.difference(sets.player1).size,
	both: sets.player1.intersection(sets.player2).size,
} satisfies Record<(typeof DISPLAYS)[number], number>;

const COLOR_BY_DISPLAY = {
	"only-player-1": "bg-primary/10 text-primary",
	"only-player-2": "bg-accent/10 text-accent",
	both: "bg-neutral/10 text-neutral",
} satisfies Record<(typeof DISPLAYS)[number], string>;

const TAB_COLOR_BY_DISPLAY = {
	"only-player-1":
		"hover:text-primary bg-primary/10 has-checked:text-primary hover:bg-primary/20",
	"only-player-2":
		"hover:text-accent bg-accent/10 has-checked:text-accent hover:bg-accent/20",
	both: "hover:text-neutral bg-neutral/10 has-checked:text-neutral hover:bg-neutral/20",
} satisfies Record<(typeof DISPLAYS)[number], string>;
const BADGE_BY_DISPLAY = {
	"only-player-1": "badge-primary",
	"only-player-2": "badge-accent",
	both: "badge-neutral",
} satisfies Record<(typeof DISPLAYS)[number], string>;
---

<SheetModal
	hx-indicator:inherited="closest .titles-container"
	hx-vals:inherited={JSON.stringify(params)}
>
	<h2 class="text-center text-2xl font-medium">Owned titles comparison</h2>

	<div
		class="container mx-auto mt-4 grid h-[60vh] w-full grid-cols-3 max-lg:hidden"
	>
		{
			DISPLAYS.map((display) => (
				<div class:list={["relative", COLOR_BY_DISPLAY[display]]}>
					<h2
						class:list={[
							"py-2 text-center text-xl font-medium",
							COLOR_BY_DISPLAY[display],
						]}
					>
						{displayCount[display]} &mdash;{" "}
						{display === "both" ? startCase(display) : `@${usernames[display]}`}
					</h2>

					<div class="titles-container absolute inset-0 top-12 overflow-y-auto p-4">
						<div
							hx-get="/vs/titles/items"
							hx-trigger="intersect once"
							hx-vals:append={JSON.stringify({ display })}
							class="titles"
						/>
					</div>

					<div class="htmx-indicator absolute center badge w-max badge-xl badge-neutral">
						<span class="skeleton skeleton-text"> Loading titles... </span>
					</div>
				</div>
			))
		}
	</div>

	<div class="contents lg:hidden">
		<fieldset class="tabs mt-4 w-full tabs-sm" role="tablist">
			{
				DISPLAYS.map((display, idx) => (
					<label
						class:list={[
							"tab indicator h-16 flex-1 flex-col indicator-center indicator-bottom",
							TAB_COLOR_BY_DISPLAY[display],
						]}
					>
						<input
							hx-get="/vs/titles/items"
							hx-browser-indicator="true"
							hx-disable="closest .tabs"
							hx-indicator="this, #tab-titles"
							hx-target="#tab-titles"
							class="peer"
							name="display"
							type="radio"
							value={display}
							checked={idx === 0}
						/>
						<IconLoader
							class="size-5"
							name={
								display === "both" ? "lucide--square-equal" : "lucide--user"
							}
						/>
						{display === "both" ? startCase(display) : `@${usernames[display]}`}

						<span
							class:list={[
								"pointer-events-none indicator-item badge badge-xs not-peer-checked:badge-soft",
								BADGE_BY_DISPLAY[display],
							]}
						>
							{displayCount[display]}
						</span>
					</label>
				))
			}
		</fieldset>

		<div class="relative h-[60vh] w-full">
			<div class="titles-container absolute inset-0 overflow-y-auto p-4">
				<div
					hx-get="/vs/titles/items"
					hx-trigger="intersect once"
					hx-vals:append={JSON.stringify({ display: DISPLAYS[0] })}
					class="titles"
					id="tab-titles"
				>
				</div>
			</div>

			<div class="htmx-indicator absolute center badge badge-xl badge-neutral">
				<span class="skeleton skeleton-text"> Loading titles... </span>
			</div>
		</div>
	</div>
</SheetModal>
