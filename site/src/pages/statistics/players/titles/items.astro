---
import { displayCategory, titles } from "virtual:bandori-leaderboard";
import z from "zod";

import { paginate } from "~/lib/paginate";
import TitleWithPlayers from "./_title-with-players.astro";

export const partial = true;

const { category } = Astro.locals.parseQuery(
	z.object({ category: z.enum(Object.keys(titles)) }),
);

const page = await paginate({
	context: Astro,
	items: [...titles[category]],
	size: 192,
	swap: "after",
	params: { category },
	extraProps: {
		"hx-target": "closest .contents",
		"hx-indicator": "closest .contents",
	},
});
---

{
	page.current === 1 ? (
		<div class="card">
			<div class="card-body max-h-[60vh] items-center">
				<div class="card-title">
					{titles[category].length} &mdash; {displayCategory[category]}
				</div>

				<div class="titles overflow-y-auto">
					{page.items.map((titleId, idx) => (
						<TitleWithPlayers
							{titleId}
							{...(page.isLastElement(idx) && page.props)}
						/>
					))}

					<div class="htmx-indicator absolute center badge badge-xl badge-neutral">
						<span class="skeleton skeleton-text"> Loading titles... </span>
					</div>
				</div>
			</div>
		</div>
	) : (
		page.items.map((titleId, idx) => (
			<TitleWithPlayers
				{titleId}
				{...(page.isLastElement(idx) && page.props)}
			/>
		))
	)
}
