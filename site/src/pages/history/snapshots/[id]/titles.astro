---
import { db } from "@bandori-stats/database";
import { displayCategory, titles } from "virtual:bandori-leaderboard";
import { getTitleImage } from "~/lib/assets";
import { paginate } from "~/lib/paginate";
import { IdSchema } from "~/lib/schema";
import { categorize } from "~/lib/titles";

export const partial = true;

const id = IdSchema.parse(Astro.params.id);
const snapshot = await db().query.accountSnapshots.findFirst({
	columns: { accountId: true, stats: true },
	where: { id },
	orderBy: { id: "desc" },
});

const snapshotTitles = snapshot?.stats.titles ?? [];
const isNotFound = !snapshot || snapshotTitles.length === 0;
if (isNotFound) Astro.response.status = 404;

const previous = isNotFound
	? undefined
	: await db().query.accountSnapshots.findFirst({
			columns: { stats: true },
			where: { id: { lt: id }, accountId: snapshot.accountId },
			orderBy: { id: "desc" },
		});

const { grouped, categorized } = categorize(snapshotTitles, {
	categories: ["new", ...Object.keys(titles)],
});

{
	const previousTitles = new Set(previous?.stats.titles ?? []);
	const newTitles = categorized
		.filter(({ id }) => !previousTitles.has(id))
		.map(({ id }) => ({ id, category: "new" as const }));
	grouped.new = newTitles.map(({ id }) => id);
	categorized.unshift(...newTitles);
}

const page = await paginate({
	items: categorized,
	context: Astro,
	size: 120,
	swap: "after",
});
---

{
	page.items.map(({ id, category }, idx, items) => (
		<>
			{((idx === 0 &&
				(page.current === 1 ||
					categorized[page.size * (page.current - 1) - 1].category !==
						category)) ||
				(idx > 0 && items[idx - 1].category !== category)) && (
				<div class="divider my-1 basis-full">
					<div class="badge badge-sm font-medium badge-accent">
						{grouped[category].length} &mdash;{" "}
						{category === "new" ? "New Titles" : displayCategory[category]}
					</div>
				</div>
			)}

			<img
				{...(page.isLastElement(idx) && page.props)}
				class="aspect-23/5 rounded-2xl"
				src={getTitleImage(id)}
				loading="lazy"
			/>
		</>
	))
}
