---
import dayjs from "@bandori-stats/bestdori/date";
import BaseLayout from "~/layouts/base-layout.astro";
import ThemeSelector from "~/layouts/components/theme-selector.astro";
---

<BaseLayout title="Update Queue" containerClass="max-w-xl" page={null}>
	<div class="mb-8 flex items-center justify-between">
		<a
			class="link text-2xl font-medium link-hover"
			href="/"
			style="view-transition-name: site-heading"
		>
			bandori-stats
		</a>
		<ThemeSelector />
	</div>

	<div class="card">
		<div class="card-body px-0">
			<h2 class="card-title self-center">
				Current time: {dayjs.tz().format("DD MMMM, HH:mm")}
			</h2>

			<div
				hx-get="/info/queued-accounts/list"
				hx-trigger="intersect once"
				class="list px-8 py-1"
			>
				{Array.from({ length: 5 }).map(() => <div class="list-row skeleton" />)}
			</div>
		</div>
	</div>
</BaseLayout>
